//@version=6
//@description Shared PD response, CISD and drawing engine for ICY x ICT22 Framework v1.1.17 (Core v1.0.9). Publish privately as ICYFrameworkCore (as a new version if an earlier Core is already published) before importing it into the main indicator.
library("ICYFrameworkCore", overlay = true)

// Core v1.0.9 (review cleanup, for Framework v1.1.17)
//   * Removed the unused f_closure export. No other export, type or behaviour changes.
//   * Function docs describe each helper instead of the generic "Shared Framework" text.
//   * Framework v1.1.17 also runs on Core v1.0.8, so publishing this version is optional.
// Core v1.0.8 (HTF inversion lifecycle and side-label layout, for Framework v1.1.15)
//   * HTF key gaps invert once on a completed owner close; the inverse can then fail.
//   * Original geometry/identity retained; inverse DRAW pins and grouping are distinct.
//   * Side labels use minimum spacing and connectors without changing any price level.
// Core v1.0.7 (compiled size, for Framework v1.1.13)
//   * Display and selection helpers move here from the indicator, unchanged apart from taking
//     the indicator's globals as parameters: HUD / legend cells, line-style setting, curve arc
//     points, zone time line, PD array tooltip, structure score, swing picks / cluster names and
//     HTF key-area picks. Imported code does not count toward the indicator's compiled size.
// Core v1.0.6 (review fixes, for Framework v1.1.10)
//   * Breaker provenance is seeded on every stream, so HTF1 / HTF2 breakers can qualify too
//     (previously only chart-stream OBs were tested and every HTF breaker read "OB flip").
//   * PDBar.b0: first chart bar of the owner candle. HTF CISD anchors use it, so a Daily
//     fallback CISD starts on its own candle instead of the next day's first bar.
// Core v1.0.5 (HTF FVG key levels, for Framework v1.1.9)
//   * Exact source/formation identities keep lifecycle state on repeated detection.
//   * Each HTF retains its own bounded registry; only its own close invalidates it.
//   * Same-polarity groups retain original owner bounds and a common intersection.
//     Grouping is display metadata: it never changes entry, response or draw rules.
//   * Non-integral-hour timeframe labels preserve their exact minute count.
// Core v1.0.4 (array provenance, for Framework v1.1.8)
//   * Failed OBs retain their response identity. Only a recorded prior swing sweep
//     followed by a later displacement close through structure earns the BB caption.
//   * Original qualification, activation and sweep/break evidence remain separate.
//   * These fields are descriptive: response, flow, chain and target rules are retained.
// Core v1.0.3 (chart cleanup, for Framework v1.1.7)
//   * All price drawing factories force the main chart pane and its price scale.
//   * Removed the limit-study type, functions and configuration fields.
//   * Removed text fields used only by the retired PD matrix HUD.
// Core v1.0.2 (review fixes, for Framework v1.1.5)
//   * BPR identity uses both contributing FVG timestamps; an exact formation keeps its lifecycle.
//   * HTF CISD retains its run-start anchor and full protected extreme. Only a completed
//     source candle releases it; invalidation clears the complete confirmed state.
// Core v1.0.1 (review cleanup, for Framework v1.1.4)
//   * PDArr.obBar: chart-stream bar of the order-block candle; role flips inherit it, so the
//     narrative OB / breaker lines start on the order-block candle.
//   * PDConfig.narrOb / narrBrk: the chart stream records OBs and breakers whenever the indicator's
//     narratives read them, independent of the expanded-zone detector toggles.
//   * One child path for role flips (FVG -> iFVG, OB -> BB, BB -> ROB?).
//   * Removed never-read fields: PDArr.eventBar, PDStream hiT / loT / rangeT / flowFrom / lastCont,
//     PDLimit.key.

// Imported code compiles separately. Every registry belongs to the caller; there
// is no hidden mutable global state, input, request or order execution here.
// Original donor attribution and model notes remain in the main indicator.
const color NOCOL = #00000000

export type HLvl
    float  price
    int    dir
    string name
    int    bornBar
    int    state = 0
    int    src   = 1
export type PFvg
    float  top
    float  bot
    int    dir
    int    t0
    string tf
    int    state = 0
    int    conf         // last chart bar of the HTF candle that completed the gap; taps count after it
    int    src = 0      // 1 HTF1 / 2 HTF2; display labels never identify an owner
    int    known = na   // chart bar at which the completed formation was registered
    int    invertedAt = na // confirmed owner-close inversion; original dir / bounds / anchor stay immutable
export type PFGroup
    PFvg owner
    array<PFvg> members
    float overlapTop
    float overlapBot
    int overlapFrom
export type CMapCis
    int    id
    int    si
    int    dir
    float  lvl
    int    fromB
    int    atB
    float  ext
    bool   tested = false
export type CMapArr
    int    cid
    int    dir
    int    kind
    int    si
    float  top
    float  bot
export type CMapStrm
    int    si
    string tag
    bool   act  = false
    bool   live = false
    float  fo = na
    float  fh = na
    float  fl = na
    float  fc = na
    int    fB = na
    array<float> O
    array<float> H
    array<float> L
    array<float> C
    array<int>   SB
    int    seq = 0
    int    prevBody = 0
    float  dnOpen = na
    int    dnSeq = na
    int    dnEnd = na
    bool   dnArm = false
    float  upOpen = na
    int    upSeq = na
    int    upEnd = na
    bool   upArm = false
    int    pBK = na
    int    pBE = na
    int    pB0 = na
    int    pBC = na
    int    pSK = na
    int    pSE = na
    int    pS0 = na
    int    pSC = na
export type CisdK
    float  lvl
    int    dir
    int    pri
    int    fromB
    string name
    string tags
    bool   dashed = false
    int    seqId  = 0
    int    cl     = -1
    int    rec    = 0      // recency (bar) - breaks ties between equal owners
export type PDArr
    int id
    int src
    string kind
    int dir
    float top
    float bot
    int origin
    int known
    int bornSeq
    int impulse
    int parentId = 0
    int contextId = 0
    int state = 0
    int testedSeq = na
    int rejectSeq = na
    float rejectHi = na
    float rejectLo = na
    int eventSeq = na
    int eventContext = 0
    int touches = 0
    float depth = 0
    bool inTest = false
    bool sib = false
    float mt = na
    int obBar = na          // chart stream: bar of the order-block candle (OB and its role flips)
    int pairOrigin = na     // BPR: opposing FVG timestamp; origin identifies the new FVG
    int firstKnown = na     // original qualification bar; role flips inherit this
    int poolId = 0          // confirmed source swing that existed by the OB candle
    float poolPx = na
    int raidSeq = na        // latest extension of that sweep; completed source candles
    int raidTime = na
    float raidExtreme = na
    int structureId = 0    // confirmed opposite swing at the OB candle
    float structurePx = na // intervening extreme from OB candle through the sweep
    int breakerKnown = na  // later displacement close; NEVER the sweep candle
export type PDBar
    int t
    float o
    float h
    float l
    float c
    float a
    int b
    int b0 = na     // first chart bar of the owner candle (HTF CISD anchors); b = processing bar
export type PDStream
    int src
    string tag
    array<PDArr> A
    array<PDBar> bars
    int seq = 0
    int lastT = na
    float ownerAtr = na
    int nextId = 0
    int impulse = 0
    float lastHi = na
    float prevHi = na
    float lastLo = na
    float prevLo = na
    int hiSeq = na
    int loSeq = na
    float rangeHi = na
    float rangeLo = na
    int rangeN = 0
    int rangeBreak = na
    int rangeKnown = na
    int cisDir = 0
    float cisLevel = na
    float cisGuard = na
    int cisSeq = na
    int cisBar = na
    int cisFrom = na
    int runDir = 0
    float dnOpen = na
    float upOpen = na
    int dnFrom = na
    int upFrom = na
    float dnGuard = na
    float upGuard = na
    int dnEnd = na
    int upEnd = na
    bool dnArmed = false
    bool upArmed = false
    bool dnObUsed = false
    bool upObUsed = false
    PDBar dnBar
    PDBar upBar
    int cDir = 0
    int cSeq = na
    float cGuard = na
    int holdB = na
    int holdS = na
    int failB = na
    int failS = na
    int holdBId = 0
    int holdSId = 0
    int failBId = 0
    int failSId = 0
    int flow = 0
    int chainB = 0
    int chainS = 0
    int chainBAt = na
    int chainSAt = na
    int chainBOb = 0
    int chainSOb = 0
    int exhDir = 0
    int exhState = 0
    int exhAt = na
    float exhHi = na
    float exhLo = na
    int exhPulse = 0
    int holdPulse = 0
    int failPulse = 0
    int cont = 0
    int contBar = na

export type PDConfig
    float tick
    bool pdFallback
    bool pdHasParent
    array<PDStream> pdStreams
    PDStream pdS0
    array<HLvl> hls
    array<PFvg> pfvgs
    int i_atrLen
    string i_entryAt
    float i_fvgMin
    string i_mtBasis
    int i_pdAge
    bool i_pdBb
    bool i_pdBpr
    float i_pdBuf
