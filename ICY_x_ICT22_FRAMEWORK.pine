string ST_KEY       = core.f_sty(input.string("Dotted", "", options = ["Solid", "Dotted", "Dashed"], group = GRP_DLVL, inline = "l2", display = display.none, active = i_pFvg))
bool   i_keyCe      = input.bool(true, "Key-area C.E.", group = GRP_DLVL, inline = "l3", active = i_pFvg)
string ST_KEYCE     = core.f_sty(input.string("Dotted", "", options = ["Solid", "Dotted", "Dashed"], group = GRP_DLVL, inline = "l3", display = display.none, active = i_pFvg and i_keyCe))
int    W_KEYCE      = input.int(1, "", minval = 1, maxval = 4, group = GRP_DLVL, inline = "l3", display = display.none, active = i_pFvg and i_keyCe)
bool   i_parentCisd = input.bool(true, "Parent CISD", group = GRP_DLVL, inline = "l4", tooltip = "Parent, CISD+ map and narrative CISDs share one renderer: a cluster is drawn at its highest-timeframe owner with that owner's row. Forming and tested CISDs are faded and dashed.")
