bool   i_zones      = input.bool(true, "PD zones", group = GRP_DLVL, inline = "l10", tooltip = "All arrays: expanded zones (edges, midpoint). Focus: related supporting midpoints. Colours follow Bull / Bear / Tested; breakers use the iFVG colour.")
string ST_ZONE      = core.f_sty(input.string("Solid", "", options = ["Solid", "Dotted", "Dashed"], group = GRP_DLVL, inline = "l10", display = display.none, active = i_zones))
string ST_ZONEMID   = core.f_sty(input.string("Dotted", "mid", options = ["Solid", "Dotted", "Dashed"], group = GRP_DLVL, inline = "l10", display = display.none, active = i_zones))
