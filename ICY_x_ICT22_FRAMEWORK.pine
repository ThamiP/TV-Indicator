string ST_PCISD     = core.f_sty(input.string("Solid", "", options = ["Solid", "Dotted", "Dashed"], group = GRP_DLVL, inline = "l4", display = display.none, active = i_parentCisd))
int    W_PCISD      = input.int(1, "", minval = 1, maxval = 4, group = GRP_DLVL, inline = "l4", display = display.none, active = i_parentCisd)
bool   i_cisdMap    = input.bool(true, "CISD+ map", group = GRP_DLVL, inline = "l5")
color  C_MCISD      = input.color(#8C919B, "", group = GRP_DLVL, inline = "l5", active = i_cisdMap)
string ST_MCISD     = core.f_sty(input.string("Solid", "", options = ["Solid", "Dotted", "Dashed"], group = GRP_DLVL, inline = "l5", display = display.none, active = i_cisdMap))
int    W_MCISD      = input.int(1, "", minval = 1, maxval = 4, group = GRP_DLVL, inline = "l5", display = display.none, active = i_cisdMap)
bool   i_contLine   = input.bool(true, "HTF body 50%", group = GRP_DLVL, inline = "l6", tooltip = "Previous HTF1 body 50% (HTF continuation mode). Bull / Bear while continuation is armed; this colour otherwise.")
