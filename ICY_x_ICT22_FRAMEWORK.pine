// Response engine and retained optional studies; visual settings do not own state.
string GRP_RESP = "14 PD response"
string GRP_NEW  = "15 Arrays"
string GRP_LAB  = "16 Studies"
string GRP_GRID = "17 SMT"
bool   i_pdEngine = input.bool(true, "PD response engine", group = GRP_RESP)
// Full help (i_pdDaily): Uses native completed Daily candles for arrays, responses, range, CISD and C-sequence on unpaired intraday charts; Weekly is the second context. Native snapshots become available on the next chart bar.
bool   i_pdDaily = input.bool(true, "Full Daily PD context on unpaired intraday charts", group = GRP_RESP, tooltip = "Unpaired intraday: completed Daily / Weekly context engine.")
// Full help (i_pdConfirm): A touch starts testing. A close outside the supporting edge creates a rejection candidate. Follow-through requires a later source-timeframe close beyond that rejection candle's extreme. CISD requires a later same-direction CISD. Close rejection confirms immediately at that source close.
string i_pdConfirm = input.string("Follow-through", "Hold confirmation", options = ["Follow-through", "CISD", "Either", "Close rejection"], group = GRP_RESP, tooltip = "Touch -> edge rejection -> later extreme break/CISD. Close rejection confirms now.")
int    i_pdAge = input.int(120, "Array retention (source candles)", minval = 20, maxval = 400, group = GRP_RESP)
int    i_pdCap = input.int(64, "Arrays retained per stream", minval = 24, maxval = 100, group = GRP_RESP)
int    i_pdFlowAge = input.int(16, "Response relevance (source candles)", minval = 3, maxval = 100, group = GRP_RESP)
int    i_pdStale = input.int(0, "Unresolved test expiry (0 = descriptive only)", minval = 0, maxval = 100, group = GRP_RESP)
float  i_pdBuf = input.float(0.0, "Failure buffer (source ATR)", minval = 0, maxval = 1, step = 0.01, group = GRP_RESP)
string i_pdCont = input.string("Response + local CISD", "Continuation qualification", options = ["Response", "Response + local CISD", "Response + local CISD + FVG", "Legacy body 50%"], group = GRP_RESP)
bool   i_pdDraw = input.bool(true, "Allow expanded HTF1 arrays as draw candidates", group = GRP_RESP)

bool   i_pdOb = input.bool(true, "Qualified order blocks", group = GRP_NEW)
float  i_pdObBody = input.float(0.5, "OB qualification: displacement body / ATR", minval = 0, maxval = 3, step = 0.1, group = GRP_NEW)
bool   i_pdBb = input.bool(true, "Failed OBs / qualified breakers", group = GRP_NEW)
bool   i_pdBpr = input.bool(true, "BPR response lifecycle", group = GRP_NEW)
bool   i_pdRb = input.bool(true, "HTF C2 rejection-wick blocks + midpoint", group = GRP_NEW)
float  i_pdWick = input.float(0.3, "Rejection wick: minimum fraction of candle range", minval = 0.1, maxval = 0.9, step = 0.05, group = GRP_NEW)
// Full help (i_pdMb): Bull: confirmed higher swing low after a prior low, then bullish CISD; bearish mirror. The relevant opposite candle becomes the MB. This explicit operational definition is shown separately from a swept-level breaker.
bool   i_pdMb = input.bool(true, "Mitigation blocks: failed swing extension + CISD", group = GRP_NEW, tooltip = "Higher low + bullish CISD, or lower high + bearish CISD. Opposite candle = MB.")
bool   i_pdVi = input.bool(true, "Volume imbalances (body gaps, wicks overlap)", group = GRP_NEW)
// Full help (i_pdVoid): Two directional displacement bodies, each at least 0.7 ATR, with little body overlap. Tracks a price-delivery zone; no volume/order-book measurement is implied.
bool   i_pdVoid = input.bool(true, "Liquidity-void price proxy", group = GRP_NEW, tooltip = "Two same-direction bodies >=0.7 ATR, little overlap. Price proxy only.")
// Full help (i_pdImplied): Three candles with overlapping outer wicks but separated outer wick midpoints around a directional displacement candle. Label IFG? distinguishes this proxy from an inverse FVG.
bool   i_pdImplied = input.bool(true, "Implied-gap study", group = GRP_NEW, tooltip = "Outer wick midpoints around displacement. IFG? proxy; distinct from iFVG.")
// Full help (i_pdReclaim): An original qualified OB fails into a breaker; failure of that breaker creates a reclaimed-OB candidate in the original direction. No recursive flip chain.
bool   i_pdReclaim = input.bool(true, "Reclaimed blocks", group = GRP_NEW, tooltip = "Failed OB -> BB; failed BB -> original-direction ROB?. No recursive flips.")
// Full help (i_pdOpenGaps): Exchange trading-day / week boundary open versus the immediately preceding chart close. Session template affects the boundaries. Not a midnight-specific gap definition.
bool   i_pdOpenGaps = input.bool(true, "NDOG / NWOG zones", group = GRP_NEW, tooltip = "Exchange D/W open vs previous chart close; session-template dependent.")

bool   i_pdChain = input.bool(true, "Track ordered OB -> breaker -> BPR -> FVG study", group = GRP_LAB)
// Full help (i_pdChainGate): Experimental compulsory sequence. Original OB must be the breaker's parent; each later stage requires a later source candle. Raw arrays and reversal mapping stay visible.
bool   i_pdChainGate = input.bool(false, "Require full chain for CONT", group = GRP_LAB, tooltip = "Requires ancestor OB, own BB, then later BPR/FVG candles. Experimental.")
// Full help (i_pdScore): A deterministic checklist percentage, NOT a probability or win rate. Same-impulse FVG/BISI/CE/OB features may be shown in the raw count; the unique count groups them by source impulse; these are not statistically independent observations.
bool   i_pdScore = input.bool(true, "Structure percentage + raw / unique impulse counts", group = GRP_LAB, tooltip = "HUD row in All arrays view (Focus off). Checklist %, NOT win probability. Impulse groups are not independent evidence.")
string i_pdScoreMode = input.string("Structure", "Score display", options = ["Structure", "Raw confluence"], group = GRP_LAB)
// Full help (i_pdEarlyExh): Uses only information available now: extended delivery plus an opposing rejection wick. EXH? is provisional; a later close through its opposite extreme confirms response. New extension invalidates it. Separate from post-draw exhaustion.
bool   i_pdEarlyExh = input.bool(true, "Early exhaustion candidates and follow-through", group = GRP_LAB, tooltip = "Stretch + rejection wick. Later opposite break confirms; extension invalidates.")
float  i_pdExhStretch = input.float(2.5, "Early exhaustion: stretch / source ATR", minval = 1, maxval = 10, step = 0.25, group = GRP_LAB)
int    i_pdExhLife = input.int(3, "Early exhaustion follow-through window", minval = 1, maxval = 10, group = GRP_LAB)

bool   i_pdSmt = input.bool(false, "SMT divergence study", group = GRP_GRID)
// Full help (i_pdSmtSym): Choose a distinct positively correlated symbol. Compares successive confirmed chart swing extremes with the comparison symbol at those same timestamps. Missing or mismatched bars are ignored.
string i_pdSmtSym = input.symbol("CME_MINI:ES1!", "SMT comparison", group = GRP_GRID, tooltip = "Distinct correlated symbol; confirmed swings at matched timestamps only.")
bool   i_pdSmtGate = input.bool(false, "Require recent SMT for study signals", group = GRP_GRID)



// =============================================================================
// 2 · CONSTANTS · HELPERS
// =============================================================================
color NOCOL  = color.new(#000000, 100)

// One fill control for every array; strengths never exceed the selected opacity.
f_arrayFill(color ink, float strength) =>
    color.new(ink, i_arrayShade ? 100.0 - i_arrayOpacity * strength : 100.0)

int CAP_FZ_BOX  = 80
int LEDGER_CAP  = 5000
int FVG_CAP     = 80
int FVG_AGE     = 400
int MAX_MARKS   = 3
int MS_DAY      = 86400000
int LEG_LOOK    = 300      // manipulation-leg origin lookback (bars)
int GAP_LEN     = 8        // minimum gap history-box length (bars)

int EV_GRAB  = 0
int EV_SHIFT = 2
int EV_ARRAY = 4
int EV_TAP   = 6
int EV_DRAW  = 8
int EV_FAIL  = 10
int EV_CONT  = 12

string SZ  = core.f_size(i_lblSz)
string FSZ = core.f_size(i_fvgSz)

// =============================================================================
// 3 · TYPES  (swing levels, HTF gaps, PD arrays and CISD map types live in Core)
// =============================================================================
// Aggregated parent (HTF1) candle
type PCandle
    int    t
    int    seq
    float  o
    float  h
    float  l
    float  c
    int    b0
    int    hiBar
    int    loBar

// Liquidity generation / accumulation range tracker
type Acc
    bool   on = false
    int    s
    float  t
    float  b
    float  cap
    box    bx
    box    lastBx
    int    lastS
    int    lastE
    bool   lastClaimed = false

// One mapped narrative (no orders). stage 1 GRAB · 2 SHIFT · 3 ARRAY (awaiting its retest)
// · 4 DELIVERY · 5 DONE. result 1 draw reached · -1 failed (grab extreme traded after the retest)
// · 2 missed (draw before any retest) · 3 expired · 4 invalid · 5 no array · 6 timed out
// · 7 ambiguous · 9 no shift
type Seq
    int    dir
    int    id
    int    stage     = 0
    int    result    = 0
    float  poolPx
    string poolName  = ""
    int    poolKind  = 0
    int    sweepIdx
    int    sweepTime
    float  ext
    int    extIdx
    bool   htf       = false
    string htfName   = ""
    bool   acc       = false
    float  legPx                 // origin of the manipulation leg (MMXM: where the first side of the curve starts)
    int    legIdx
    bool   mmxm      = false     // the manipulation leg qualifies as one side of the MMXM curve
    bool   hasIfvg   = false     // a gap of the manipulation leg inverted after the grab
    float  cisdLvl
    int    cisdIdx
    float  mssLvl
    int    mssIdx
    int    shiftIdx
    string shiftType = ""
    float  obTop
    float  obBot
    float  obMT
    int    obIdx
    bool   hasBrk    = false
    float  brkTop
    float  brkBot
    float  brkOpen
    int    brkIdx
    float  legExt                // displacement leg extreme at publication (Premium / Discount 0.5)
    float  dlvExt                // delivery extreme since the grab (the second side of the curve)
    int    dlvIdx
    string arrName   = ""
    float  arrTop
    float  arrBot
    int    pubIdx
    int    arrIdx                // exact selected candle anchor, also after registry retirement
    int    pdEntryId = 0          // descriptive identity; never reselects a reaction
    core.PDArr pdEntryRef = na    // preserves failed colour after registry retirement
    int    pdEntryImpulse = 0     // captured at publication; no repeated registry joins in rendering
    int    pdEntryContext = 0
    int    pdDrawId = 0           // chosen PD target identity; zero for other target sources
    string pfDrawKey = ""         // exact HTF gap phase; grouping or inversion cannot reassign this target
    float  rtPx                  // retest price of the entry array (proximal edge or C.E. / MT)
    float  invPx                 // invalidation just beyond the grab extreme
    float  drawPx
    string drawName  = ""
    string drawKind  = ""
    int    pdBprId    = 0
    int    pdObId     = 0
    int    pdBbId     = 0
    int    tapIdx
    int    propIdx
    float  propLvl
    bool   propDone  = false
    bool   propEnd   = false
    int    nIofed    = 0
    int    nBg       = 0
    bool   dead      = false
    bool   drawingsRetired = false // capacity cleanup is visual; ownership survives
    line   lnCisd
    label  lbCisd
    line   lnBrk
    label  lbBrk
    line   lnOb
    label  lbOb
    box    bxBpr
    line   lnProp
    array<label>    L
    array<line>     N
    array<box>      B
    array<polyline> P

// Chart-TF fair value gap. state 0 fresh · 1 mitigated · 2 inverted (iFVG) · 3 dead
// role 0 plain · 1 entry · 2 delivery · 3 iFVG of a narrative
// sty (drawn role) 0 none · 1 context box (raw / delivery / narrative iFVG) · 2 selected box
type FVG
    int    dir
    float  top
    float  bot
    int    idx
    int    born
    int    origin = na          // timestamp of the middle candle; same identity as the PD FVG
    int    state    = 0
    int    role     = 0
    int    touchIdx
    int    invIdx
    int    killIdx
    bool   bg       = false   // first untouched delivery gap
    bool   mg       = false   // later untouched delivery gap (measuring)
    bool   exh      = false
    string pd       = ""
    bool   sib      = false   // SIBI / BISI: all three candles close in the gap's direction
    bool   isEntry  = false   // the narrative's MSS entry array (FVG or iFVG)
    bool   fz       = false   // entry box frozen: its narrative resolved
    int    sty      = 0
    Seq    owner
    box    bx
    line   ce
    label  lb

// =============================================================================
// 4 · CORE SERIES  (all ta.* / request.* calls unconditional, global scope)
// =============================================================================
float atr   = ta.atr(i_atrLen)
float atrA  = ta.atr(50)
float atrS  = nz(atr, high - low)
// Visible candles inform label spacing only; they never gate engine state.
var float sideViewHi = na
var float sideViewLo = na
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    sideViewHi := na(sideViewHi) ? high : math.max(sideViewHi, high)
    sideViewLo := na(sideViewLo) ? low : math.min(sideViewLo, low)
float tick  = syminfo.mintick
bool cf = barstate.isconfirmed

float iph = ta.pivothigh(high, i_intLen, i_intLen)
float ipl = ta.pivotlow(low, i_intLen, i_intLen)

float accHH = ta.highest(high, i_accLen)
float accLL = ta.lowest(low, i_accLen)

int chSec = timeframe.in_seconds(timeframe.period)
string tfA =
     map_on_1  and chSec == timeframe.in_seconds(map_chart_1)  ? map_htf1_1  :
     map_on_2  and chSec == timeframe.in_seconds(map_chart_2)  ? map_htf1_2  :
     map_on_3  and chSec == timeframe.in_seconds(map_chart_3)  ? map_htf1_3  :
     map_on_4  and chSec == timeframe.in_seconds(map_chart_4)  ? map_htf1_4  :
     map_on_5  and chSec == timeframe.in_seconds(map_chart_5)  ? map_htf1_5  :
     map_on_6  and chSec == timeframe.in_seconds(map_chart_6)  ? map_htf1_6  :
     map_on_7  and chSec == timeframe.in_seconds(map_chart_7)  ? map_htf1_7  :
     map_on_8  and chSec == timeframe.in_seconds(map_chart_8)  ? map_htf1_8  :
     map_on_9  and chSec == timeframe.in_seconds(map_chart_9)  ? map_htf1_9  :
     map_on_10 and chSec == timeframe.in_seconds(map_chart_10) ? map_htf1_10 :
     map_on_11 and chSec == timeframe.in_seconds(map_chart_11) ? map_htf1_11 : ""
string tfB =
     map_on_1  and chSec == timeframe.in_seconds(map_chart_1)  ? map_htf2_1  :
     map_on_2  and chSec == timeframe.in_seconds(map_chart_2)  ? map_htf2_2  :
     map_on_3  and chSec == timeframe.in_seconds(map_chart_3)  ? map_htf2_3  :
     map_on_4  and chSec == timeframe.in_seconds(map_chart_4)  ? map_htf2_4  :
     map_on_5  and chSec == timeframe.in_seconds(map_chart_5)  ? map_htf2_5  :
     map_on_6  and chSec == timeframe.in_seconds(map_chart_6)  ? map_htf2_6  :
     map_on_7  and chSec == timeframe.in_seconds(map_chart_7)  ? map_htf2_7  :
     map_on_8  and chSec == timeframe.in_seconds(map_chart_8)  ? map_htf2_8  :
     map_on_9  and chSec == timeframe.in_seconds(map_chart_9)  ? map_htf2_9  :
     map_on_10 and chSec == timeframe.in_seconds(map_chart_10) ? map_htf2_10 :
     map_on_11 and chSec == timeframe.in_seconds(map_chart_11) ? map_htf2_11 : ""

int tfASec = tfA == "" ? 0 : timeframe.in_seconds(tfA)
int tfBSec = tfB == "" ? 0 : timeframe.in_seconds(tfB)
bool pairOK = tfA != "" and tfB != "" and tfASec > chSec and tfBSec > tfASec and tfASec % chSec == 0
string tfAq = pairOK ? tfA : timeframe.period
string tfBq = pairOK ? tfB : tfAq
string lblA = pairOK ? core.f_tfLbl(tfA) : i_pdEngine and i_pdDaily and chSec < 86400 ? "1D" : "—"
string lblB = pairOK ? core.f_tfLbl(tfB) : i_pdEngine and i_pdDaily and chSec < 86400 ? "1W" : "—"
// The HUD and continuation caption retain Daily context when there is no valid pairing.
string contextTfLbl = pairOK ? lblA : "1D"
// Completed HTF2 candles: [1] = last closed, [2] / [3] before it (lookahead_on on closed bars = stable).
f_hPack() =>
    [high[1], high[3], low[1], low[3], close[1], time[1], time[3]]
[bH1, bH3, bL1, bL3, bC1, bT1, bT3] = request.security(syminfo.tickerid, tfBq, f_hPack(), lookahead = barmerge.lookahead_on)
bool newB = pairOK and not na(bT1) and bT1 != nz(bT1[1], -1)

// Only Daily timing is needed for the unpaired HUD's forming / closed state.
// Completed Daily / Weekly engine inputs remain independent below.
[dT0, dTC0] = request.security(syminfo.tickerid, "D", [time, time_close], lookahead = barmerge.lookahead_off)
bool dailyForming = not na(dTC0) and (barstate.isrealtime ? timenow : time_close) < dTC0

// Continuation inputs are separate from the developing Daily timing snapshot.
// Offset + lookahead_on exposes the same completed Daily body throughout each day
// on historical and realtime intraday bars. Compare it with the confirmed CHART close.
[dayPrevO, dayPrevC] = request.security(syminfo.tickerid, "D", [open[1], close[1]], lookahead = barmerge.lookahead_on)
int dayOpenT = time("D")

int pOpenT  = time(tfAq)
int pCloseT = time_close(tfAq)
bool pEnd   = not na(pCloseT) and time_close >= pCloseT   // this chart bar closes the HTF1 candle
int h2OpenT = time(tfBq)

// CISD+ exact-multiple ladder frames below the parent, built from chart bars.
bool cR60    = pairOK and 60 > chSec and 60 < tfASec and 60 % chSec == 0
bool cR180   = pairOK and 180 > chSec and 180 < tfASec and 180 % chSec == 0
bool cR300   = pairOK and 300 > chSec and 300 < tfASec and 300 % chSec == 0
bool cR900   = pairOK and 900 > chSec and 900 < tfASec and 900 % chSec == 0
bool cR3600  = pairOK and 3600 > chSec and 3600 < tfASec and 3600 % chSec == 0
bool cR14400 = pairOK and 14400 > chSec and 14400 < tfASec and 14400 % chSec == 0
string cArrTfA = cR60 ? "1" : cR180 ? "3" : cR300 ? "5" : cR900 ? "15" : cR3600 ? "60" : cR14400 ? "240" : ""
int cArrSecA = cArrTfA == "" ? 0 : timeframe.in_seconds(cArrTfA)
string cArrTfB = cArrTfA == "" ? "" : cR180 and cArrSecA < 180 ? "3" : cR300 and cArrSecA < 300 ? "5" : cR900 and cArrSecA < 900 ? "15" : cR3600 and cArrSecA < 3600 ? "60" : cR14400 and cArrSecA < 14400 ? "240" : ""
bool cArrOnA = i_cisdMap and i_cisdLadder >= 2 and cArrTfA != ""
bool cArrOnB = i_cisdMap and i_cisdLadder >= 3 and cArrTfB != ""
string cArrTfAq = cArrTfA == "" ? timeframe.period : cArrTfA
string cArrTfBq = cArrTfB == "" ? timeframe.period : cArrTfB
int cL1T  = time(cArrTfAq)
int cL1TC = time_close(cArrTfAq)
int cL2T  = time(cArrTfBq)
int cL2TC = time_close(cArrTfBq)
bool cL1New = not na(cL1T) and (na(cL1T[1]) or cL1T != cL1T[1])
bool cL1End = not na(cL1TC) and time_close >= cL1TC
bool cL2New = not na(cL2T) and (na(cL2T[1]) or cL2T != cL2T[1])
bool cL2End = not na(cL2TC) and time_close >= cL2TC

// Native completed snapshots: UDTs avoid expanding the 127-element tuple budget.
bool pdFallback = i_pdEngine and i_pdDaily and not pairOK and chSec < 86400
bool pdHasParent = pairOK or pdFallback
string pdTf1 = pairOK ? tfA : pdFallback ? "D" : timeframe.period
string pdTf2 = pairOK ? tfB : pdFallback ? "W" : timeframe.period
f_pdPack() =>
    core.PDBar.new(time[1], open[1], high[1], low[1], close[1], ta.atr(i_atrLen)[1])
core.PDBar pdNative1 = request.security(syminfo.tickerid, pdTf1, f_pdPack(), lookahead = barmerge.lookahead_on)
core.PDBar pdNative2 = request.security(syminfo.tickerid, pdTf2, f_pdPack(), lookahead = barmerge.lookahead_on)
// the comparison symbol is requested only while SMT is on (otherwise the chart symbol: no extra feed)
[pdCmpT, pdCmpH, pdCmpL] = request.security(i_pdSmt ? i_pdSmtSym : syminfo.tickerid, timeframe.period, [time, high, low], lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
bool pdNewDay = timeframe.change("D")
bool pdNewWeek = timeframe.change("W")


// Setup-history window (calendar based, anchored to the loaded / replay chart)
f_histDays() =>
    i_setupHist == "Auto" ? (chSec <= 900 ? 1 : chSec <= 3600 ? 5 : chSec <= 14400 ? 20 : 0) : i_setupHist == "Today Only" ? 1 : i_setupHist == "2 Days" ? 2 : i_setupHist == "3 Days" ? 3 : i_setupHist == "5 Days" ? 5 : i_setupHist == "10 Days" ? 10 : 0
int histDays   = f_histDays()
int histProbe  = histDays > 0 ? last_bar_time - (histDays - 1) * MS_DAY : last_bar_time
int setupStart = histDays > 0 ? timestamp(i_tz, year(histProbe, i_tz), month(histProbe, i_tz), dayofmonth(histProbe, i_tz), 0, 0, 0) : na
bool setupWindow = histDays == 0 or time >= setupStart

// =============================================================================
// 5 · GLOBAL STATE
// =============================================================================
var array<box>   fzBox  = array.new<box>()

var array<FVG>   fvgs = array.new<FVG>()

var array<float> iHp = array.new<float>()
var array<int>   iHi = array.new<int>()
var array<float> iLp = array.new<float>()
var array<int>   iLi = array.new<int>()

// HTF2 chart-side tracking so its H/L line starts at the bar that printed the extreme.
var float h2RunH = na
var float h2RunL = na
var int   h2RunHB = na
var int   h2RunLB = na
// last three completed HTF2 candles (newest first) for the 3-candle swing test
var array<float> h2cH  = array.new_float()
var array<float> h2cL  = array.new_float()
var array<int>   h2cHB = array.new_int()
var array<int>   h2cLB = array.new_int()

// parent stream
var array<PCandle> parents = array.new<PCandle>()
var PCandle live = na
var bool liveClosed = false   // live already completed on its last chart bar; next bar opens a new parent
var int pSeq = 0

// parent CISD — CONFIRMED state only (a parent candle closed beyond the anchor)
var int   parentCisdDir = 0
var float parentCisdLevel = na
var int   parentCisdFrom = na
var int   parentCisdSeq = na
var float parentCisdGuard = na   // engine-off path only; with the PD engine, Core guards pdS1
// Latest completed opposite-colour parent run. Its open is the PENDING anchor of the
// opposite CISD and survives intervening candles until a parent close confirms it,
// a newer run replaces it, or it goes stale (i_pendMax parent candles after the run).
var int   runDir = 0
var float runOpen = na
var int   runFrom = na
var float runExt = na
var float pendBullLvl = na
var int   pendBullFrom = na
var float pendBullExt = na
var int   pendBullEnd = na
var float pendBearLvl = na
var int   pendBearFrom = na
var float pendBearExt = na
var int   pendBearEnd = na
var int   usedBullFrom = na   // run already consumed by a confirmation: never re-pended
var int   usedBearFrom = na

// HTF continuation: the live HTF1 candle vs the previous candle's body 50% (confirmed bars)
var int   contDir  = 0
var float contMid  = na
var int   contFrom = na
var int   dayB0    = na   // first chart bar of the current Daily candle (unpaired continuation line)

// raw HTF C-sequence owner (geometry owned)
var int    htfVisDir = 0
var int    htfVisC2Seq = na
var string htfVisMode = ""
var float  htfVisC1H = na
var float  htfVisC1L = na
var float  htfVisC2Ext = na
var int    htfVisFailSeq = na

// CISD+ map. One owner per list: cmReg holds the CISD and array lists and the indicator reads
// them through cmReg on every bar (a variable kept since bar 0 can be a separate copy).
var core.CMapState cmReg = core.CMapState.new(array.new<core.CMapCis>(), array.new<core.CMapArr>(), i_cisdSwingN, i_cisdKeep)
array<core.CMapCis> cMapCises = cmReg.cMapCises
// Wide UDT constructors are shared; each call allocates its own arrays and object.
var array<core.CMapStrm> cMapStreams = array.from(core.f_newCMap(0, core.f_tfLbl(timeframe.period), i_cisdMap), core.f_newCMap(1, cArrTfA == "" ? "" : core.f_tfLbl(cArrTfA), cArrOnA), core.f_newCMap(2, cArrTfB == "" ? "" : core.f_tfLbl(cArrTfB), cArrOnB))

// renderer slots (last bar only)
var array<line>  hlLn = array.new<line>(4, na)
var array<label> hlLb = array.new<label>(4, na)
var array<box>   pfOverlapBx = array.new<box>(4, na)
var array<box>   pfBx = array.new<box>(4, na)
var array<line>  pfCe = array.new<line>(4, na)
var array<label> pfLb = array.new<label>(4, na)
var array<line> sideLeaders = array.new<line>()
var array<line> sideGapGuides = array.new<line>(8, na)
int sideContIx = -1
var array<line>  cisdNestLines  = array.new<line>()
var array<label> cisdNestLabels = array.new<label>()
var array<label> chartCTags = array.new<label>(4, na)
var array<polyline> mmPl = array.new<polyline>(2, na)
var line  contLn = na
var label contLb = na

var Acc acc = Acc.new()
var Seq bullSeq  = na
var Seq bearSeq  = na
var Seq lastBull = na
var Seq lastBear = na
var int seqN     = 0
var array<Seq> doneSeq = array.new<Seq>()
// Outcome ledger for HUD statistics: one row per resolved narrative (grab time, side, result).
// Pruned only by the setup-history window, never by how many setups stay drawn.
var array<int> ledT = array.new_int()
var array<int> ledD = array.new_int()
var array<int> ledR = array.new_int()
var array<bool> ev = array.new<bool>(14, false)
array.fill(ev, false)

// One owner per list: pdCfg holds the PD streams, the swing liquidity list and the HTF key areas.
// The indicator reads them through pdCfg on every bar; a variable kept since bar 0 can be a
// separate copy on TradingView (v1.1.13 stopped on bar 31 indexing one with the other's picks).
core.PDStream pdStreamNa = na
var core.PDConfig pdCfg = core.PDConfig.new(tick, pdFallback, pdHasParent, array.from(core.f_newPDStream(0, core.f_tfLbl(timeframe.period)), core.f_newPDStream(1, core.f_tfLbl(pdTf1)), core.f_newPDStream(2, core.f_tfLbl(pdTf2))), pdStreamNa, array.new<core.HLvl>(), array.new<core.PFvg>(), i_atrLen, i_entryAt, i_fvgMin, i_mtBasis, i_pdAge, i_pdBb, i_pdBpr, i_pdBuf, i_pdCap, i_pdChain, i_pdConfirm, i_pdEarlyExh, i_pdExhLife, i_pdExhStretch, i_pdFlowAge, i_pdImplied, i_pdMb, i_pdOb, i_pdObBody, i_pdRb, i_pdReclaim, i_pdStale, i_pdVi, i_pdVoid, i_pdWick, i_pendMax, i_seqOn, i_seqOn and i_showBrk)
array<core.PDStream> pdStreams = pdCfg.pdStreams
core.PDStream pdS0 = array.get(pdStreams, 0)
core.PDStream pdS1 = array.get(pdStreams, 1)
core.PDStream pdS2 = array.get(pdStreams, 2)
pdCfg.pdS0 := pdS0
// Context stream for flow, range, CONT, score and exhaustion: HTF1 (or the Daily fallback) when present.
core.PDStream pdContext = pdHasParent ? pdS1 : pdS0
// hls: swing levels (dir +1 BSL / -1 SSL; state 0 live / 1 taken; src 1 HTF1 draws, arms grabs and
// can be the draw, src 2 HTF2 only joins a nearby HTF1 label). pfvgs: HTF key areas (state 0 fresh /
// 1 tapped / 2 invalid).
array<core.HLvl> hls = pdCfg.hls
array<core.PFvg> pfvgs = pdCfg.pfvgs
var array<box> pdZoneBoxes = array.new<box>(12, na)
var array<line> pdZoneHi = array.new<line>(12, na)
var array<line> pdZoneLo = array.new<line>(12, na)
var array<line> pdZoneMid = array.new<line>(12, na)
var array<label> pdZoneLabels = array.new<label>(12, na)
var array<line> pdRangeLines = array.new<line>(9, na)
var array<label> pdRangeLabels = array.new<label>(9, na)
var array<line> pdObstLines = array.new<line>(2, na)
var array<label> pdObstLabels = array.new<label>(2, na)
var array<line> focusLines = array.new<line>(10, na)
var array<label> focusLabels = array.new<label>(10, na)
var array<box> focusBoxes = array.new<box>(2, na)
var array<label> pdStudyMarks = array.new<label>()
var float pdSmtHi = na
var float pdSmtLo = na
var float pdSmtCmpHi = na
var float pdSmtCmpLo = na
var int pdSmtDir = 0
var int pdSmtAt = na
var int pdContSignal = 0


// =============================================================================
// 6 · HELPERS — frozen rings, H/L registry, HTF FVGs, chart-FVG rendering
// =============================================================================
f_fzBox(box b) =>
    if not na(b)
        array.push(fzBox, b)
        if array.size(fzBox) > CAP_FZ_BOX
            box.delete(array.shift(fzBox))

// ── swing liquidity slot: one HTF1 swing line with its clustered label ──────────
f_drawHLSlot(int slot, int idx, float tol, float tol2, float dolPx, int dolDir, bool isDraw) =>
    line outL = array.get(hlLn, slot)
    label outB = array.get(hlLb, slot)
    if i_showHL and idx >= 0
        core.HLvl s = array.get(hls, idx)
        [nm, born, dol] = core.f_hlCluster(pdCfg, idx, tol, tol2, dolPx, dolDir)
        int x1 = core.f_past(na(born) ? s.bornBar : born)
        int xr = bar_index + i_right
        outL := core.f_line(outL, x1, s.price, xr, s.price, color.new(C_LIQ, 25), ST_LIQ, W_LIQ)
        outB := core.f_label(outB, xr + 1, s.price, nm + (dol ? " · DOL" : "") + (isDraw ? " · DRAW" : ""), C_LIQ, label.style_label_left, size.tiny)
    else
        outL := core.f_hideLine(outL)
        outB := core.f_hideLabel(outB)
    array.set(hlLn, slot, outL)
    array.set(hlLb, slot, outB)
    true

// ── HTF FVG key areas: original bounds, shared overlap, independent lifecycle ──
// First live HTF FVG / iFVG of current polarity d containing px; context is not display-gated.
f_pfvgHit(int d, float px, float tol) =>
    string nm = ""
    for z in pfvgs
        if z.state < 2 and core.f_pfDir(z) == d and px <= z.top + tol and px >= z.bot - tol
            nm := core.f_pfName(z)
            break
    nm

f_drawPFvgSlot(int slot, core.PFGroup g, array<string> pins, float hlTol) =>
    box ob = array.get(pfBx, slot)
    box band = array.get(pfOverlapBx, slot)
    line ol = array.get(pfCe, slot)
    label ot = array.get(pfLb, slot)
    if not na(g)
        core.PFvg z = g.owner
        int zoneDir = core.f_pfDir(z)
        string zoneKind = core.f_pfKind(z)
        int n = array.size(g.members)
        int tapped = 0
        bool draw = false
        array<string> tags = array.new_string()
        string detail = ""
        for member in g.members
            tapped += member.state == 1 ? 1 : 0
            bool pinned = array.includes(pins, core.f_pfKey(member))
            draw := draw or pinned
            if not array.includes(tags, member.tf)
                array.push(tags, member.tf)
            detail += "\n" + core.f_pfName(member) + ": " + str.tostring(member.bot, format.mintick) + "–" + str.tostring(member.top, format.mintick) + " · " + (member.state == 1 ? "tapped" : "fresh") + (pinned ? " · selected DRAW" : "") + " · known at chart bar " + str.tostring(member.known) + (na(member.invertedAt) ? "" : " · inverted at chart bar " + str.tostring(member.invertedAt)) + " · original anchor " + str.format_time(member.t0, "yyyy-MM-dd HH:mm", i_tz)
        bool grey = tapped == n
        color base = grey ? C_GREY : C_HTF
        int xr = time + chSec * 1000 * i_right
        float mid = math.avg(z.top, z.bot)
        if na(ob)
            ob := core.f_newBox(z.t0, z.top, xr, z.bot, color.new(base, 65), f_arrayFill(base, grey ? 0.3 : 0.7), ST_KEY, true, "", color.black, false, false)
        else
            box.set_lefttop(ob, z.t0, z.top)
            box.set_rightbottom(ob, xr, z.bot)
            box.set_border_color(ob, color.new(base, 65))
            box.set_bgcolor(ob, f_arrayFill(base, grey ? 0.3 : 0.7))
        bool shared = n > 1 and (g.overlapTop < z.top or g.overlapBot > z.bot)
        if shared
            if na(band)
                band := core.f_newBox(g.overlapFrom, g.overlapTop, xr, g.overlapBot, color.new(base, 82), f_arrayFill(base, grey ? 0.2 : 0.3), ST_KEY, true, "", color.black, false, false)
            else
                box.set_lefttop(band, g.overlapFrom, g.overlapTop)
                box.set_rightbottom(band, xr, g.overlapBot)
                box.set_border_color(band, color.new(base, 82))
                box.set_bgcolor(band, f_arrayFill(base, grey ? 0.2 : 0.3))
        else
            band := core.f_hideBox(band)
        if not i_keyCe
            ol := core.f_hideLine(ol)
        else if na(ol)
            ol := core.f_newLine(z.t0, mid, xr, mid, color.new(base, 65), ST_KEYCE, W_KEYCE, true)
        else
            line.set_xy1(ol, z.t0, mid)
            line.set_xy2(ol, xr, mid)
            line.set_color(ol, color.new(base, 65))
        int hi = core.f_pfHL(pdCfg, g, hlTol)
        string relation = ""
        string pool = ""
        if hi >= 0
            core.HLvl h = array.get(hls, hi)
            [hn, _, _] = core.f_hlCluster(pdCfg, hi, atrS * i_hlClusterAtr, atrS * i_h2Near, float(na), 0)
            relation := h.price >= z.bot and h.price <= z.top ? "at " : zoneDir == 1 ? "below " : "above "
            relation += zoneDir == 1 ? "SSL" : "BSL"
            pool := "\nH/L relation: " + relation + " · " + hn + " @ " + str.tostring(h.price, format.mintick) + ". Location context only."
        string caption = array.join(tags, "/") + (zoneDir == 1 ? " +" : " -") + zoneKind + " · KEY" + (n > 1 ? " ×" + str.tostring(n) : "") + (relation != "" ? " · " + relation : "") + (grey ? " · TAP" : tapped > 0 ? " · mixed tests" : "") + (draw ? " · DRAW" : "")
        ot := core.f_label(ot, bar_index + i_right + 1, mid, caption, color.new(base, 25), label.style_label_left, size.tiny)
        label.set_tooltip(ot, "HTF " + zoneKind + " key area for ERL / IRL context. H/L pools supply external liquidity context; this is not an entry or a mandatory ERL→IRL sequence.\nOutline / C.E.: " + core.f_pfName(z) + " at its original bounds.\n" + (n > 1 ? "Shared intersection: " + str.tostring(g.overlapBot, format.mintick) + "–" + str.tostring(g.overlapTop, format.mintick) + ". No union of the members; overlap is one location, not independent confirmations." : "Single confirmed formation.") + pool + "\nMembers:" + detail + "\nTouches only mark a tap. A completed owner-timeframe close through the far edge flips an FVG into an iFVG; failure of that inverse retires it. Original DRAW pins never transfer to the inverse.")
    else
        ob := core.f_hideBox(ob)
        band := core.f_hideBox(band)
        ol := core.f_hideLine(ol)
        ot := core.f_hideLabel(ot)
    array.set(pfBx, slot, ob)
    array.set(pfOverlapBx, slot, band)
    array.set(pfCe, slot, ol)
    array.set(pfLb, slot, ot)
    true


// Focus is a renderer. These predicates never appear in state or outcome conditions.
f_seqLive(Seq s) =>
    not na(s) and not s.dead and s.stage >= 1 and s.stage <= 4

f_focusRelated(core.PDArr a, Seq s) =>
    bool related = false
    if f_seqLive(s) and a.state < 4 and a.dir == s.dir
        bool owned = a.id == s.pdObId or a.id == s.pdBbId or a.id == s.pdBprId or a.id == s.pdEntryId
        bool impulse = a.src == 0 and s.pdEntryImpulse != 0 and a.impulse == s.pdEntryImpulse and a.known >= s.sweepIdx
        bool parent = a.id == s.pdEntryContext
        bool grabContext = a.src > 0 and a.known <= s.sweepIdx and a.bot <= s.ext and a.top >= s.ext
        related := owned or impulse or parent or grabContext
    related

f_focusOverlap(core.PDArr a, Seq s) =>
    f_seqLive(s) and s.stage >= 3 and (i_fvgMode != "Off" or str.contains(s.arrName, "OB")) and f_focusRelated(a, s) and math.min(a.top, s.arrTop) > math.max(a.bot, s.arrBot)

f_focusKind(core.PDArr a) =>
    a.kind != "VI" and a.kind != "VOID?" and a.kind != "IFG?" and a.kind != "ROB?" and (a.kind != "BB" or not na(a.breakerKnown))

// ── PD engine: confirmed source-candle events; drawings never own logic ───────
f_pdAllowed(int d) =>
    bool smt = not i_pdSmtGate or (i_pdSmt and pdSmtDir == d and not na(pdSmtAt) and bar_index - pdSmtAt <= i_pdFlowAge)
    bool chain = not i_pdChainGate or (i_pdChain and (d == 1 ? pdContext.chainB : pdContext.chainS) == 4)
    smt and chain

// nearest eligible observed draw, independently of the nearest-obstacle readout.
// kind: SWING (HTF1 swing) or ARRAY (enabled HTF FVG / iFVG candidate, established HTF1 PD array).
f_findDraw(int d, float need) =>
    float  best = na
    int    bi   = -1
    string nm   = ""
    string knd  = ""
    int targetId = 0
    string gapKey = ""
    int n = array.size(hls)
    if n > 0
        for i = 0 to n - 1
            core.HLvl l = array.get(hls, i)
            if l.state == 0 and l.src == 1 and l.dir == d and d * (l.price - need) >= 0 and (na(best) or d * (best - l.price) > 0)
                best := l.price
                bi   := i
    if bi >= 0
        [cn, _, _] = core.f_hlCluster(pdCfg, bi, atrS * i_hlClusterAtr, atrS * i_h2Near, float(na), 0)
        nm  := cn
        knd := "SWING"
    for z in pfvgs
        float lv = d == 1 ? z.bot : z.top
        if i_pFvgDraw and z.state < 2 and core.f_pfDir(z) == -d and d * (lv - need) >= 0 and (na(best) or d * (best - lv) > 0)
            best := lv
            nm   := core.f_pfName(z)
            knd  := "ARRAY"
            gapKey := core.f_pfKey(z)
    if i_pdEngine and i_pdDraw and pdHasParent
        for a in pdS1.A
            // established arrays only: the VI / VOID? / IFG? / ROB? proxies are never a draw on liquidity
            bool kindOK = a.kind == "iFVG" or a.kind == "OB" or a.kind == "BB" or a.kind == "BPR" or a.kind == "RB" or a.kind == "MB"
            float lv = d == 1 ? a.bot : a.top
            if kindOK and a.state < 4 and a.dir == -d and d * (lv - need) >= 0 and (na(best) or d * (best - lv) > 0)
                best := lv
                nm   := pdS1.tag + " " + (a.kind == "BB" and na(a.breakerKnown) ? "OB flip" : a.kind)
                targetId := a.id
                gapKey := ""
                knd  := "ARRAY"
    [best, nm, knd, targetId, gapKey]

// ── chart-TF FVG drawing ─────────────────────────────────────────────────────
// Light boxes for FVG / iFVG, with optional C.E.; the selected reaction is more visible.
//   sty 1  context: raw-PA SIBI / BISI on any timeframe (bull / bear colour) and their inversions
//          (iFVG, purple); Breakaway / Measuring / Exhaustion delivery gaps; the narrative iFVG
//   sty 2  MSS Premium / Discount entry array: filled box + dotted C.E.
// The nearest live arrays per side reach the live bar with a tag (last bar); every other gap stays a
// short history mark. Casual gaps are tracked, never drawn, unless a narrative claims their inversion.
f_fvgStyle(FVG f) =>
    int st = 0
    if i_fvgMode != "Off"
        if f.isEntry
            st := 2
        else if f.role == 3 or f.bg or f.mg or f.exh or (f.sib and i_fvgMode == "Raw PA")
            st := 1
    st

// the iFVG of a narrative that is still live (stays lit and reaches the live bar)
f_fvgLiveIfvg(FVG f) =>
    f.role == 3 and not na(f.owner) and not f.owner.dead and f.owner.stage <= 4

f_fvgText(FVG f) =>
    bool   inv = f.state >= 2
    string sg  = (inv ? -f.dir : f.dir) == 1 ? "+" : "-"
    string nm  = inv ? sg + "iFVG" : f.exh ? "Exhaustion Gap" : f.bg ? "Breakaway Gap" : f.mg ? "Measuring Gap" : sg + "FVG"
    nm + (f.isEntry and i_pdTag and f.pd != "" ? " · " + f.pd : "")

// right edge of a context box: an active array reaches the live bar; a history mark stops at its
// last event (touch · inversion · kill), at least GAP_LEN bars after the gap
f_fvgRight(FVG f, bool act) =>
    int ev0 = f.state == 3 ? nz(f.killIdx, f.idx) : f.state == 2 ? nz(f.invIdx, f.idx) : f.state == 1 ? nz(f.touchIdx, f.idx) : f.idx
    act and f.state < 3 ? bar_index : math.min(bar_index, math.max(f.idx + GAP_LEN, ev0))

f_fvgPaint(FVG f, bool act) =>
    bool dead = f.state == 3 or (f.isEntry and not na(f.owner) and (f.state >= 2 ? -f.dir : f.dir) != f.owner.dir)
    bool mark = f.bg or f.mg or f.exh
    bool lit = not dead and (act or mark or f_fvgLiveIfvg(f) or f.isEntry)
    // Focus: colour belongs to the live narrative (its reaction box, one footprint gap and the CONT
    // gap are painted by the focus renderer). Everything else stays in the dim study colour: raw PA
    // until a grab activates a narrative, and completed narratives afterwards.
    bool liveOwner = not na(f.owner) and f_seqLive(f.owner)
    bool doneOwner = not na(f.owner) and not liveOwner
    // display switches: the entry array and iFVG boxes can be hidden in either view
    bool shown = (not i_focus or (liveOwner ? not f.isEntry : doneOwner ? i_focusHistory : i_focusRaw)) and (f.isEntry ? i_showEntry : f.state < 2 or i_showIfvg)
    color base = dead ? C_GREY : i_focus ? C_DIM : f.isEntry ? ((f.state == 2 ? -f.dir : f.dir) == 1 ? C_ARRB : C_ARR) : f.state == 2 ? C_IFVG : f.exh ? C_EXH : mark ? C_BG : f.dir == 1 ? C_FVGB : C_FVGS
    float fillStrength = dead ? 0.3 : i_focus ? (lit ? 0.6 : 0.4) : not lit ? 0.3 : f.isEntry ? 1.0 : 0.7
    int bdT = i_focus ? (dead ? 88 : lit ? 72 : 84) : dead or not lit ? 88 : f.isEntry ? 55 : 72
    if not na(f.bx)
        box.set_bgcolor(f.bx, shown ? f_arrayFill(base, fillStrength) : NOCOL)
        box.set_border_color(f.bx, shown ? color.new(base, bdT) : NOCOL)
        box.set_border_style(f.bx, f.isEntry ? ST_ENTRY : f.state >= 2 ? ST_IFVG : f.exh ? ST_EXH : mark ? ST_BG : ST_FVG)
    if not na(f.ce)
        line.set_color(f.ce, shown ? color.new(base, lit ? (i_focus ? 72 : 65) : 90) : NOCOL)
    if not na(f.lb)
        label.set_y(f.lb, math.avg(f.top, f.bot))
        label.set_size(f.lb, FSZ)
        if not na(f.bx)
            label.set_x(f.lb, box.get_right(f.bx) + i_lblGap)
        label.set_text(f.lb, shown and lit ? f_fvgText(f) : "")
        label.set_textcolor(f.lb, shown ? (i_focus ? color.new(base, 35) : base) : NOCOL)
        label.set_tooltip(f.lb, "Original formation known at bar " + str.tostring(f.born) + (f.state >= 2 ? "; inversion active from " + str.tostring(f.invIdx) : "") + (f.state == 3 ? "; failed at " + str.tostring(f.killIdx) : "") + ". Original price bounds retained.")
    true

// Both roles use the original price bounds and middle-candle anchor.
f_fvgDraw(FVG f) =>
    if f.sty > 0 and (na(f.owner) or not f.owner.drawingsRetired)
        float mid = math.avg(f.top, f.bot)
        int rt = f.sty == 1 ? f_fvgRight(f, false) : f.state == 1 and not na(f.touchIdx) ? f.touchIdx : f.state == 3 and not na(f.killIdx) ? f.killIdx : bar_index
        f.bx := core.f_newBox(core.f_past(f.idx), f.top, rt, f.bot, NOCOL, NOCOL, ST_FVG, false, "", color.black, false, false)
        if i_fvgCe
            f.ce := core.f_newLine(core.f_past(f.idx), mid, rt, mid, NOCOL, ST_CE, W_CE, false)
        if i_fvgLbl
            f.lb := core.f_newLabel(rt + i_lblGap, mid, "", label.style_label_left, NOCOL, C_TXT, FSZ, "", true)
    true

f_fvgClearDrawings(FVG f) =>
    if not na(f.bx)
        box.delete(f.bx)
        f.bx := na
    if not na(f.ce)
        line.delete(f.ce)
        f.ce := na
    if not na(f.lb)
        label.delete(f.lb)
        f.lb := na
    true

f_fvgDelete(FVG f) =>
    f_fvgClearDrawings(f)
    f.sty := 0
    true

// (re)style: a role change swaps the drawing language. Colours come later: a gap is painted from
// its final state in the last-bar pass, or when it leaves the registry (compiled size: the paint is
// inlined at those two call sites only)
f_fvgBox(FVG f) =>
    int st = f_fvgStyle(f)
    if st != f.sty
        f_fvgDelete(f)
        f.sty := st
    if st > 0 and na(f.bx)
        f_fvgDraw(f)
    true

// right edge of the entry box (box + C.E.; the tag sits outside); frozen once its narrative resolved
f_fvgEdge(FVG f, int x) =>
    if f.sty == 2 and not f.fz
        if not na(f.bx)
            box.set_right(f.bx, x)
        if not na(f.ce)
            line.set_x2(f.ce, x)
        if not na(f.lb)
            label.set_x(f.lb, x + i_lblGap)
    true

// Place a context gap: active boxes reach the live bar; history stops at its last event.
f_fvgLines(FVG f, bool act) =>
    if f.sty == 1
        int x2 = f_fvgRight(f, act)
        if not na(f.ce)
            line.set_x2(f.ce, x2)
        if not na(f.bx)
            box.set_right(f.bx, x2)
        if not na(f.lb)
            label.set_x(f.lb, x2 + i_lblGap)
    true

// Leaving the registry: an owned FVG hands its drawings to its narrative, so deleting
// the narrative (keep cap or history window) deletes them too. Unowned drawings go now.
f_fvgRetire(FVG f) =>
    if f.sty > 0
        f_fvgLines(f, false)
        if f.state == 0 or f.state == 2
            f_fvgEdge(f, bar_index)
        f_fvgPaint(f, false)
        Seq o = f.owner
        if (not i_focus or i_focusHistory) and f.role > 0 and not na(o) and not o.dead
            if not na(f.bx)
                array.push(o.B, f.bx)
            if not na(f.ce)
                array.push(o.N, f.ce)
            if not na(f.lb)
                array.push(o.L, f.lb)
            f.bx  := na
            f.ce  := na
            f.lb  := na
            f.sty := 0
        else
            f_fvgDelete(f)
    true

// retest price of an array for direction d: proximal edge, or C.E. / OB mean threshold
f_entryPx(int d, float top, float bot, float mt) =>
    i_entryAt == "Proximal" ? (d == 1 ? top : bot) : na(mt) ? (top + bot) / 2 : mt

// optional ICT22-style gate on the RETEST price: below EQ for longs, above EQ for shorts
f_pdOk(int d, float e, float eqv) =>
    not i_pdGate or na(eqv) or (d == 1 ? e < eqv : e > eqv)

// most recent internal pivot strictly before bar `before`
f_lastBefore(array<float> P, array<int> I, int before) =>
    float rp = na
    int   ri = na
    int   n  = array.size(I)
    if n > 0
        for k = n - 1 to 0
            if array.get(I, k) < before
                rp := array.get(P, k)
                ri := array.get(I, k)
                break
    [rp, ri]

// ── MMXM side-of-the-curve arcs ──────────────────────────────────────────────
// one side of the curve, owned by the narrative: an optional dashed arc, no tag (the engine runs regardless)
f_curve(Seq s, int xE, float yE, bool first) =>
    if i_mmxmArcs and math.abs(s.extIdx - xE) >= 4 and s.dir * (yE - s.ext) > 0
        array.push(s.P, polyline.new(core.f_curvePts(xE, yE, s.extIdx, s.ext, first), curved = true, line_color = color.new(C_ARC, 15), line_style = ST_ARC, line_width = W_ARC, force_overlay = true))
    true

// =============================================================================
// 7 · NARRATIVE — sequence methods (ICY engine, MMXM display)
// =============================================================================
f_seqClearDrawings(Seq o) =>
    for xl in o.L
        label.delete(xl)
    for xn in o.N
        line.delete(xn)
    for xb in o.B
        box.delete(xb)
    for xp in o.P
        polyline.delete(xp)
    array.clear(o.L)
    array.clear(o.N)
    array.clear(o.B)
    array.clear(o.P)
    true

f_seqDelete(Seq o) =>
    o.dead := true
    f_seqClearDrawings(o)
    // released gaps drop their narrative styling: a raw SIBI / BISI of the window keeps its light box
    for f in fvgs
        if not na(f.owner) and f.owner.id == o.id
            f.owner   := na
            f.role    := 0
            f.isEntry := false
            f.bg      := false
            f.mg      := false
            f.exh     := false
            f.fz      := false
            f_fvgBox(f)
    true

f_pruneDone() =>
    // Logical retention remains deterministic; object counts retire drawings only.
    while array.size(doneSeq) > i_keepSeq
        Seq o = array.shift(doneSeq)
        f_seqDelete(o)
    for o in doneSeq
        if not o.drawingsRetired and (array.size(line.all) > 350 or array.size(label.all) > 350 or array.size(box.all) > 350)
            o.drawingsRetired := true
            f_seqClearDrawings(o)
            for f in fvgs
                if not na(f.owner) and f.owner.id == o.id
                    // Keep sty/role/owner as selector state, even without drawing IDs.
                    f_fvgClearDrawings(f)
    true

f_pruneHistory() =>
    if histDays > 0
        int n = array.size(doneSeq)
        if n > 0
            for k = n - 1 to 0
                Seq o = array.get(doneSeq, k)
                if na(o.sweepTime) or o.sweepTime < setupStart
                    array.remove(doneSeq, k)
                    f_seqDelete(o)
        int m = array.size(ledT)
        if m > 0
            for k = m - 1 to 0
                if array.get(ledT, k) < setupStart
                    array.remove(ledT, k)
                    array.remove(ledD, k)
                    array.remove(ledR, k)
    true

// CISD level: open of the first candle of the opposite-close series into the grab extreme
method calcCisd(Seq s) =>
    int d   = s.dir
    int k0  = bar_index - s.extIdx
    int j   = k0
    int lim = math.min(k0 + 10, 450)
    while j <= lim and not (d == 1 ? close[j] < open[j] : close[j] > open[j])
        j += 1
    if j <= lim
        int lim2 = math.min(j + 30, 490)
        while j < lim2 and (d == 1 ? close[j + 1] < open[j + 1] : close[j + 1] > open[j + 1])
            j += 1
        s.cisdLvl := open[j]
        s.cisdIdx := bar_index - j
    true

method calcMss(Seq s) =>
    array<float> P = s.dir == 1 ? iHp : iLp
    array<int>   I = s.dir == 1 ? iHi : iLi
    [mp, mi] = f_lastBefore(P, I, s.extIdx)
    s.mssLvl := mp
    s.mssIdx := mi
    true

// (1) HTF array under the grab: a live HTF FVG of the right polarity, or the swept HTF1 swing pool
method htfCheck(Seq s) =>
    if not s.htf
        string nm = f_pfvgHit(s.dir, s.ext, 0.25 * atrS)
        // every swept level is an HTF1 swing, so the pool itself is HTF liquidity (ICY v1.1.3)
        if nm == "" and s.poolKind >= 1
            nm := s.poolName
        if nm != ""
            s.htf     := true
            s.htfName := nm
    true

method findOb(Seq s) =>
    s.obIdx  := na
    s.pdObId := 0
    for a in pdS0.A
        if a.kind == "OB" and a.dir == s.dir and a.state < 4 and a.known >= s.extIdx
            // the line starts on the order-block candle (qualification bar only as a fallback)
            s.obIdx  := nz(a.obBar, a.known)
            s.obTop  := a.top
            s.obBot  := a.bot
            s.obMT   := a.mt
            s.pdObId := a.id
    true

method findBreaker(Seq s) =>
    s.hasBrk := false
    s.pdBbId := 0
    for a in pdS0.A
        if a.kind == "BB" and not na(a.breakerKnown) and a.parentId != 0 and a.dir == s.dir and a.state < 4 and a.known >= s.sweepIdx
            core.PDArr original = core.f_pdById(pdS0, a.parentId)
            if not na(original) and original.kind == "OB" and original.state == 4 and original.known < a.known
                s.hasBrk := true
                s.brkIdx := nz(a.obBar, a.known)
                s.pdBbId := a.id
                s.brkTop := a.top
                s.brkBot := a.bot
                s.brkOpen := na(a.mt) ? (a.top + a.bot) / 2 : a.mt
    true

// A delivery gap changes polarity on inversion. Its old owner cannot block the opposite
// narrative; selected entry arrays and already claimed narrative iFVGs keep their ownership.
f_canClaimIfvg(FVG f, Seq s) =>
    not na(s) and not s.dead and s.stage >= 2 and s.stage <= 3 and f.dir == -s.dir and f.state == 2 and (f.role == 0 or (f.role == 2 and not f.isEntry)) and not na(f.invIdx) and f.invIdx >= s.sweepIdx and not na(s.legIdx) and f.born >= s.legIdx

f_claimIfvg(FVG f, Seq s) =>
    f.role     := 3
    f.owner    := s
    f.isEntry  := false
    f.pd       := ""
    f.bg       := false
    f.mg       := false
    f.exh      := false
    f.fz       := false
    s.hasIfvg  := true
    f_fvgBox(f)

method claimIfvg(Seq s) =>
    for f in fvgs
        if f_canClaimIfvg(f, s)
            f_claimIfvg(f, s)
    true

// live right edges of the narrative's context lines until its array is retested
method ctxEdges(Seq s, int x) =>
    if not na(s.lnCisd)
        line.set_x2(s.lnCisd, x + i_cisdExt)
        label.set_x(s.lbCisd, x + i_cisdExt)
    if not na(s.lnBrk)
        line.set_x2(s.lnBrk, x + i_cisdExt)
        label.set_x(s.lbBrk, x + i_cisdExt)
    if not na(s.lnOb)
        line.set_x2(s.lnOb, x)
        label.set_x(s.lbOb, x + i_lblGap)
    if not na(s.bxBpr)
        core.PDArr bpr = core.f_pdById(pdS0, s.pdBprId)
        bool activeBpr = s.pdBprId == 0 or (not na(bpr) and bpr.state < 4)
        if activeBpr
            box.set_right(s.bxBpr, x)
        else
            box.set_border_color(s.bxBpr, C_GREY)
            box.set_bgcolor(s.bxBpr, f_arrayFill(C_GREY, 0.4))
    true

f_seqFocusEnd(Seq s) =>
    if i_focus
        for ln in s.N
            line.set_color(ln, i_focusHistory ? color.new(C_DIM, 55) : NOCOL)
        for lb in s.L
            label.set_textcolor(lb, i_focusHistory ? color.new(C_DIM, 35) : NOCOL)
            label.set_color(lb, NOCOL)
        for bx in s.B
            box.set_bgcolor(bx, i_focusHistory ? f_arrayFill(C_DIM, 0.4) : NOCOL)
            box.set_border_color(bx, i_focusHistory ? color.new(C_DIM, 80) : NOCOL)
            box.set_text_color(bx, i_focusHistory ? color.new(C_DIM, 45) : NOCOL)
        if not i_focusHistory
            for pl in s.P
                polyline.delete(pl)
            array.clear(s.P)
    true

method resolve(Seq s, int res) =>
    int d  = s.dir
    int sd = d == 1 ? 0 : 1
    s.stage  := 5
    s.result := res
    if na(s.tapIdx)
        s.ctxEdges(bar_index)
    if not na(s.lnProp) and not s.propEnd
        line.set_x2(s.lnProp, bar_index)
    // the CISD renderer may have hidden this line under an HTF owner while it was live
    if not na(s.lnCisd)
        line.set_color(s.lnCisd, C_NCISD)
        label.set_textcolor(s.lbCisd, C_NCISD)
    array.push(ledT, s.sweepTime)
    array.push(ledD, d)
    array.push(ledR, res)
    if array.size(ledT) > LEDGER_CAP
        array.shift(ledT)
        array.shift(ledD)
        array.shift(ledR)
    string mk = res == 1 ? "✓" : res == -1 ? "✕" : res == 7 ? "? ambiguous" : res == 2 ? "missed" : res == 3 ? "expired" : res == 4 ? "invalid" : res == 5 ? "no array" : res == 6 ? "timed out" : ""
    float  my = res == 1 or res == 2 ? s.drawPx : res == -1 ? s.invPx : not na(s.rtPx) ? s.rtPx : s.ext
    if i_showOutcome and mk != "" and not na(my)
        string ms = res == 1 ? (d == 1 ? label.style_label_down : label.style_label_up) : res == -1 ? (d == 1 ? label.style_label_up : label.style_label_down) : label.style_label_left
        color  mc = res == 1 ? C_WIN : res == -1 ? C_LOSS : C_TXT
        array.push(s.L, core.f_newLabel(bar_index, my, mk, ms, NOCOL, mc, res == 1 or res == -1 ? size.normal : size.tiny, "", false))
    if res == 1 and i_exh
        for f in fvgs
            if f.dir == d and (f.role == 1 or f.role == 2) and not na(f.owner) and f.owner.id == s.id and f.born >= bar_index - i_exhBars
                f.exh := true
                f_fvgBox(f)
    // MMXM: the delivery completed the second side of the curve
    if s.mmxm and (res == 1 or res == 2) and not na(s.drawPx)
        f_curve(s, bar_index, s.drawPx, false)
    // the MSS entry box stops extending (history now); light array boxes keep mapping raw PA
    for f in fvgs
        if not na(f.owner) and f.owner.id == s.id and f.sty == 2
            if f.state == 0 or f.state == 2
                f_fvgEdge(f, bar_index)
            f.fz := true
    if res == 1
        array.set(ev, EV_DRAW + sd, true)
    else if res == -1
        array.set(ev, EV_FAIL + sd, true)
    f_seqFocusEnd(s)
    array.push(doneSeq, s)
    f_pruneDone()
    true

// (5) choose the entry array; the draw and the invalidation frame the narrative (no orders)
method publish(Seq s) =>
    s.findOb()
    int    d     = s.dir
    int    since = bar_index - s.shiftIdx
    bool   done  = false
    FVG    pick  = na
    string kind  = ""
    float  eqv   = (s.ext + s.legExt) / 2
    // the PD gate filters candidates while selecting, so a rejected FVG never blocks the iFVG / OB fallbacks
    if i_entrySrc == "Auto" or i_entrySrc == "FVG"
        for f in fvgs
            if f.dir == d and f.idx >= s.extIdx and f.state == 0 and f.role != 3 and f_pdOk(d, f_entryPx(d, f.top, f.bot, float(na)), eqv)
                pick := f
                break
        if not na(pick)
            kind := "FVG"
    if kind == "" and (i_entrySrc == "iFVG" or (i_entrySrc == "Auto" and since >= 3))
        for f in fvgs
            if f.dir == -d and f.state == 2 and f.role == 3 and not na(f.owner) and f.owner.id == s.id and f_pdOk(d, f_entryPx(d, f.top, f.bot, float(na)), eqv)
                pick := f
        if not na(pick)
            kind := "iFVG"
    float top = na
    float bot = na
    if kind != ""
        top := pick.top
        bot := pick.bot
    else if not na(s.obIdx) and (i_entrySrc == "OB" or (i_entrySrc == "Auto" and since >= 3)) and f_pdOk(d, f_entryPx(d, s.obTop, s.obBot, s.obMT), eqv)
        kind := "OB"
        top  := s.obTop
        bot  := s.obBot
    if kind != ""
        float  e   = f_entryPx(d, top, bot, kind == "OB" ? s.obMT : float(na))
        float  iv  = s.ext - d * i_stopPad * tick
        float  R   = d * (e - iv)
        // tag and gate read the same coordinate: the retest price, not the zone midpoint
        string pdz = e < eqv ? "Discount" : "Premium"
        if R > 0
            float need = e + d * i_minRR * R
            [dp, dn, dk, drawId, gapKey] = f_findDraw(d, need)
            s.pubIdx   := bar_index
            s.rtPx     := e
            s.invPx    := iv
            s.drawPx   := dp
            s.drawName := dn
            s.drawKind := dk
            s.pdDrawId := drawId
            s.pfDrawKey := gapKey
            // MMXM: the second side of the curve returns to where the first one began
            if na(s.drawPx) and s.mmxm and not na(s.legPx) and d * (s.legPx - need) >= 0 and d * (s.legPx - s.legExt) > 0
                s.drawPx   := s.legPx
                s.drawName := "Origin"
                s.drawKind := "ORIGIN"
            if na(s.drawPx)
                s.drawPx   := e + d * i_fallR * R
                s.drawName := str.tostring(i_fallR) + "R"
                s.drawKind := "PROJECTION"
            s.arrIdx   := kind == "OB" ? s.obIdx : pick.idx
            s.pdEntryId := kind == "OB" ? s.pdObId : 0
            if kind != "OB"
                for a in pdS0.A
                    if a.kind == kind and a.dir == d and a.origin == pick.origin and math.abs(a.top - top) < tick * 0.5 and math.abs(a.bot - bot) < tick * 0.5
                        s.pdEntryId := a.id
            core.PDArr selected = core.f_pdById(pdS0, s.pdEntryId)
            s.pdEntryRef := selected
            if not na(selected)
                s.pdEntryImpulse := selected.impulse
                s.pdEntryContext := selected.contextId
            s.arrTop   := top
            s.arrBot   := bot
            s.arrName  := (d == 1 ? "+" : "-") + kind + (kind == "OB" and i_entryAt != "Proximal" ? " MT" : "") + " · Leg " + pdz
            if kind != "OB"
                pick.role    := kind == "FVG" ? 1 : 3
                pick.owner   := s
                pick.pd      := "Leg " + pdz
                pick.isEntry := true
                f_fvgBox(pick)
            else if i_showEntry
                // OB-type entry array: thin grey line at its retest price (ICY), never a box
                s.lnOb := core.f_newLine(core.f_past(s.obIdx), e, bar_index, e, C_OB, ST_OB, W_OB, false)
                s.lbOb := core.f_newLabel(bar_index + i_lblGap, e, (d == 1 ? "+OB" : "-OB") + (i_pdTag ? " · Leg " + pdz : ""), label.style_label_left, NOCOL, C_OB, FSZ, "Order block " + str.tostring(s.obBot, format.mintick) + " – " + str.tostring(s.obTop, format.mintick), true)
                array.push(s.N, s.lnOb)
                array.push(s.L, s.lbOb)
            for f in fvgs
                if f.dir == d and f.idx >= s.extIdx and f.role == 0
                    f.role  := 2
                    f.owner := s
                    f_fvgBox(f)
            // the first overlapping opposite gap forms the BPR; it is tracked whatever the display
            // switch, which only draws (or skips) its box
            if kind == "FVG" and not na(s.legIdx)
                bool bprFound = false
                for g in fvgs
                    if not bprFound and g.dir == -d and g.born >= s.legIdx and g.born <= s.extIdx + 1
                        float hi2 = math.min(g.top, top)
                        float lo2 = math.max(g.bot, bot)
                        if hi2 > lo2
                            bprFound := true
                            if i_showBpr
                                s.bxBpr := core.f_newBox(math.max(g.idx, pick.idx), hi2, bar_index, lo2, color.new(C_BPR, 20), f_arrayFill(C_BPR, 1.0), ST_BPR, false, d == 1 ? "+BPR" : "-BPR", C_TXT, false, true)
                                array.push(s.B, s.bxBpr)
                            if i_pdEngine and i_pdBpr
                                // Both gap timestamps identify the formation. The shared registry
                                // reuses its exact lifecycle, even if that formation already failed.
                                core.PDArr tracked = core.f_pdAdd(pdCfg, pdS0, "BPR", d, hi2, lo2, pick.origin, pdS0.impulse, 0, false, float(na), g.origin)
                                s.pdBprId := na(tracked) ? 0 : tracked.id
            s.stage := 3
            array.set(ev, EV_ARRAY + (d == 1 ? 0 : 1), true)
            done := true
    done

// (3)(4) grab confirmed by the market shift: draw the narrative so far (some_icy_tea chart language)
method doShift(Seq s, Acc a, bool useMss) =>
    int   d   = s.dir
    int   sd  = d == 1 ? 0 : 1
    s.stage     := 2
    s.shiftIdx  := bar_index
    s.shiftType := useMss ? "MSS" : "CISD"
    // liquidity raid arc under / over the grab extreme
    if i_showRaid
        float off = 0.12 * atrS
        float dep = 0.35 * atrS
        int   e   = s.extIdx
        float y0  = s.ext - d * off
        array<chart.point> pts = array.from(chart.point.from_index(e - 3, y0), chart.point.from_index(e, y0 - d * dep), chart.point.from_index(e + 3, y0))
        array.push(s.P, polyline.new(pts, curved = true, line_color = C_RAID, line_style = ST_RAID, line_width = W_RAID, force_overlay = true))
    if i_showMss and useMss and not na(s.mssLvl) and not na(s.mssIdx)
        array.push(s.N, core.f_newLine(core.f_past(s.mssIdx), s.mssLvl, bar_index, s.mssLvl, C_MSS, ST_MSS, W_MSS, false))
        array.push(s.L, core.f_newLabel(math.round((core.f_past(s.mssIdx) + bar_index) / 2), s.mssLvl, "💡\nMarket Shift", d == 1 ? label.style_label_down : label.style_label_up, NOCOL, C_MSS, SZ, "", false))
    // ICY CISD visual: thin grey line + grey label, short extension past the shift (ICY v1.1.3)
    int cx = bar_index + i_cisdExt
    if i_showNCisd and not na(s.cisdLvl) and not na(s.cisdIdx)
        s.lnCisd := core.f_newLine(core.f_past(s.cisdIdx), s.cisdLvl, cx, s.cisdLvl, C_NCISD, ST_NCISD, W_NCISD, false)
        s.lbCisd := core.f_newLabel(cx, s.cisdLvl, (useMss ? "CISD · " : "💡 CISD · ") + core.f_tfLbl(timeframe.period), label.style_label_left, NOCOL, C_NCISD, size.tiny, "", false)
        array.push(s.N, s.lnCisd)
        array.push(s.L, s.lbCisd)
    // Qualified breaker: thin grey line at its mean threshold; the failed OB is recorded
    if useMss or (not na(s.mssLvl) and d * (close - s.mssLvl) > 0)
        s.findBreaker()
        if i_showBrk and s.hasBrk
            s.lnBrk := core.f_newLine(core.f_past(s.brkIdx), s.brkOpen, cx, s.brkOpen, C_BRK, ST_BRK, W_BRK, false)
            s.lbBrk := core.f_newLabel(cx, s.brkOpen, d == 1 ? "+Breaker" : "-Breaker", label.style_label_left, NOCOL, C_BRK, size.tiny, "Breaker block " + str.tostring(s.brkBot, format.mintick) + " – " + str.tostring(s.brkTop, format.mintick), false)
            array.push(s.N, s.lnBrk)
            array.push(s.L, s.lbBrk)
    // displacement-leg extreme (P / D) = the delivery extreme so far (second side of the curve)
    float lg = d == 1 ? high : low
    int   li = bar_index
    int   kk = bar_index - s.extIdx
    for j = 0 to kk
        float v = d == 1 ? high[j] : low[j]
        if d * (v - lg) > 0
            lg := v
            li := bar_index - j
    s.legExt := lg
    s.dlvExt := lg
    s.dlvIdx := li
    // MMXM: the manipulation leg is the first side of the curve when it spans the minimum time and
    // range and steps - a lower high on the way into a sell-side grab, a higher low into a buy-side one
    if i_mmxm and not na(s.legIdx) and not na(s.legPx)
        array<int> stepIdx = d == 1 ? iHi : iLi
        bool stepped = false
        for ix in stepIdx
            if ix > s.legIdx and ix < s.extIdx
                stepped := true
        s.mmxm := stepped and s.extIdx - s.legIdx >= i_mmxmBars and d * (s.legPx - s.ext) >= i_mmxmAtr * atrS
        if s.mmxm
            f_curve(s, s.legIdx, s.legPx, true)
    if i_accMode != "Off" and not na(a.lastBx) and not a.lastClaimed and a.lastS <= s.sweepIdx and a.lastE >= s.sweepIdx - 2 * i_shiftWin
        a.lastClaimed := true
        s.acc         := true
        array.push(s.B, a.lastBx)
        a.lastBx      := na
    s.claimIfvg()
    array.set(ev, EV_SHIFT + sd, true)
    true

method propStep(Seq s) =>
    int d = s.dir
    if not s.propDone
        bool opp  = d == 1 ? close < open : close > open
        bool into = d == 1 ? low <= s.arrTop : high >= s.arrBot
        if opp and into
            s.propIdx := bar_index
            s.propLvl := d == 1 ? high : low
        else if not na(s.propIdx) and bar_index > s.propIdx and d * (close - s.propLvl) > 0
            s.propDone := true
            s.lnProp   := core.f_newLine(core.f_past(s.propIdx), s.propLvl, bar_index, s.propLvl, C_PROP, ST_PROP, W_PROP, false)
            array.push(s.N, s.lnProp)
            array.push(s.L, core.f_newLabel(bar_index, s.propLvl, (d == 1 ? "+" : "-") + "Propulsion", label.style_label_left, NOCOL, C_PROP, size.tiny, "", false))
    else if not s.propEnd
        bool tch = d == 1 ? low <= s.propLvl : high >= s.propLvl
        if tch
            s.propEnd := true
            line.set_x2(s.lnProp, bar_index)
            if d * (close - s.propLvl) > 0
                array.push(s.L, core.f_newLabel(bar_index, s.propLvl, "○", label.style_none, NOCOL, C_PROP, SZ, "", false))
    true

method step(Seq s, Acc a, bool evOk, float evPx, string evName, int evKind) =>
    int   d   = s.dir
    int   sd  = d == 1 ? 0 : 1
    float adv = d == 1 ? low : high
    float fav = d == 1 ? high : low
    if s.stage == 1
        if d * (s.ext - adv) > 0
            s.ext    := adv
            s.extIdx := bar_index
            s.calcCisd()
            s.htfCheck()
        if evOk and d * (s.poolPx - evPx) > 0
            s.poolPx   := evPx
            s.poolName := evName
            s.poolKind := evKind
            s.htfCheck()
        s.calcMss()
        bool cisdHit = not na(s.cisdLvl) and d * (close - s.cisdLvl) > 0
        bool mssHit  = not na(s.mssLvl) and d * (close - s.mssLvl) > 0
        bool fire    = i_shiftBy == "CISD" ? cisdHit : i_shiftBy == "MSS" ? mssHit : cisdHit or mssHit
        bool bodyOk  = i_disp <= 0 or math.abs(close - open) >= i_disp * atrS
        bool dirOk   = d == 1 ? close > open : close < open
        if fire and bodyOk and dirOk
            s.doShift(a, mssHit and i_shiftBy != "CISD")
        else if bar_index - s.sweepIdx >= i_shiftWin
            s.stage  := 5
            s.result := 9
            s.dead   := true
    // single resolve / publish call sites (compiled-size discipline)
    int res = 0
    // the delivery extreme traces the second side of the MMXM curve
    if s.stage >= 2 and s.stage <= 4 and bar_index > s.shiftIdx and d * (fav - s.dlvExt) > 0
        s.dlvExt := fav
        s.dlvIdx := bar_index
    if s.stage == 2
        // the shift bar falls through here and maps the array immediately (ICY behaviour)
        if bar_index > s.shiftIdx
            s.legExt := d == 1 ? math.max(s.legExt, high) : math.min(s.legExt, low)
        if d * (s.ext - adv) > 0
            res := 4
        else
            bool ok = s.publish()
            if not ok
                if bar_index - s.shiftIdx >= i_entryWin
                    res := 3
                else if (i_entrySrc == "FVG" or i_entrySrc == "iFVG") and bar_index - s.shiftIdx >= 3
                    res := 5
    else if s.stage >= 3
        // One outcome evaluation for the retest candle and every later candle.
        // Candle order is unknown inside a bar: only the open can settle it.
        bool tapNow = false
        if s.stage == 3 and bar_index > s.pubIdx
            bool tapHit   = d == 1 ? low <= s.rtPx : high >= s.rtPx
            bool drawSeen = d == 1 ? high >= s.drawPx : low <= s.drawPx
            // a candle that opens at / beyond the draw printed it before any retest: missed
            if (d == 1 ? open >= s.drawPx : open <= s.drawPx) or (drawSeen and not tapHit)
                res := 2
            else if tapHit
                tapNow   := true
                s.stage  := 4
                s.tapIdx := bar_index
                array.set(ev, EV_TAP + sd, true)
                s.ctxEdges(bar_index)
            else if bar_index - s.shiftIdx >= i_entryWin
                res := 3
        if s.stage == 4 and res == 0 and (tapNow or bar_index > s.tapIdx)
            bool invHit   = d == 1 ? low <= s.invPx : high >= s.invPx
            bool drawHit  = d == 1 ? high >= s.drawPx : low <= s.drawPx
            bool openInv  = d == 1 ? open <= s.invPx : open >= s.invPx
            bool openDraw = d == 1 ? open >= s.drawPx : open <= s.drawPx
            // on the retest candle the retest precedes the draw only if the candle opened through it
            bool openThru = d == 1 ? open <= s.rtPx : open >= s.rtPx
            if openInv or (invHit and not drawHit)
                res := -1                                  // invalidation beyond the retest always follows it
            else if openDraw
                res := 1
            else if invHit
                res := 7                                   // invalidation and draw in one candle: AMBIGUOUS
            else if drawHit
                res := tapNow and not openThru ? 7 : 1     // intrabar retest + draw: order unknown
            else if not tapNow and bar_index - s.tapIdx >= i_tradeWin
                res := 6
            if res == 0 and not tapNow and i_prop
                s.propStep()
    if res != 0
        s.resolve(res)
    true

// right edges of live narrative drawings (last bar only)
method liveEdges(Seq s) =>
    if s.stage >= 2 and s.stage <= 4
        if na(s.tapIdx)
            s.ctxEdges(bar_index)
        if not na(s.lnProp) and not s.propEnd
            line.set_x2(s.lnProp, bar_index)
    true

f_newSeq(int d, float px, string nm, int kind, int id, int pix) =>
    Seq s = Seq.new(d, id)
    s.stage     := 1
    s.poolPx    := px
    s.poolName  := nm
    s.poolKind  := kind
    s.sweepIdx  := bar_index
    s.sweepTime := time
    s.ext       := d == 1 ? low : high
    s.extIdx    := bar_index
    // origin of the manipulation leg: the opposite extreme printed since the swept swing
    // (MMXM: where the first side of the curve begins). Also anchors the iFVG / BPR claims.
    int span = na(pix) ? 0 : math.min(bar_index - pix - 1, LEG_LOOK)
    if span >= 1
        float ex = na
        int   ei = na
        for j = 1 to span
            float v = d == 1 ? high[j] : low[j]
            if na(ex) or d * (v - ex) > 0
                ex := v
                ei := bar_index - j
        s.legPx  := ex
        s.legIdx := ei
    s.L := array.new<label>()
    s.N := array.new<line>()
    s.B := array.new<box>()
    s.P := array.new<polyline>()
    s.calcCisd()
    s.htfCheck()
    s

// =============================================================================
// 8 · HTF CONTEXT ENGINES — CISD+ map (Distilled donor), parent stream, C-sequence
// =============================================================================
f_cmTag(int si) => array.get(cMapStreams, si).tag

// ── parent stream ────────────────────────────────────────────────────────────
f_updateLive(PCandle c) =>
    c.c := close
    if high > c.h
        c.h := high
        c.hiBar := bar_index
    if low < c.l
        c.l := low
        c.loBar := bar_index
    0

f_parentAvgRange() =>
    float s = 0.0
    int n = math.min(array.size(parents), 14)
    if n > 0
        for i = 0 to n - 1
            PCandle c = array.get(parents, i)
            s += c.h - c.l
    // Native Daily fallback has no aggregated parents; use its completed-source ATR.
    n > 0 ? s / n : pdFallback and not na(pdS1.ownerAtr) ? pdS1.ownerAtr : atrS * math.max(1.0, tfASec / math.max(chSec, 1))


f_pdMark(int d, string markText, color col) =>
    if not i_focus and i_exhMarks
        label m = core.f_newLabel(bar_index, d == 1 ? low : high, markText, d == 1 ? label.style_label_up : label.style_label_down, color.new(col, 88), col, size.tiny, "", false)
        array.push(pdStudyMarks, m)
        while array.size(pdStudyMarks) > 24
            label.delete(array.shift(pdStudyMarks))
    true

f_pdStudy() =>
    if i_pdEngine and cf
        if i_pdEarlyExh and pdContext.exhPulse != 0
            f_pdMark(pdContext.exhPulse > 0 ? 1 : -1, pdContext.tag + (math.abs(pdContext.exhPulse) == 1 ? " EXH?" : " EXH response"), C_XMARK)
    true

// =============================================================================
// 9 · PER-BAR EXECUTION
// =============================================================================
// Every state change below commits on CONFIRMED chart bars only (historical bars are
// always confirmed). The open realtime candle never creates, sweeps, mitigates, publishes
// or resolves anything, so alerts and the chart history agree. It only moves live edges.
// Event pulses reset on every chart execution, including bars without an HTF close.
for pdStream in pdStreams
    pdStream.holdPulse := 0
    pdStream.failPulse := 0
    pdStream.exhPulse := 0

// ── live parent (display) ────────────────────────────────────────────────────
// The open realtime candle updates the live parent for display only (chart C-sequence tags,
// forming CISD). Pine rolls these writes back before every realtime update, so nothing
// commits until the chart bar closes. The first open bar of a new parent shows a
// provisional live candle the same way.
if pairOK and not cf and not na(live) and pOpenT != live.t
    live       := PCandle.new(pOpenT, pSeq + 1, open, high, low, close, bar_index, bar_index, bar_index)
    liveClosed := false
if not na(live) and not liveClosed and pOpenT == live.t
    f_updateLive(live)

// ── parent (HTF1) stream: H/L owners, HTF1 FVGs, raw C2 / C3 sequence, parent CISD ──
// A parent completes on the confirmed close of its own last chart bar (pass 1), so a parent
// close confirms on the HTF close, not one chart bar later. If a session ends early and that
// bar is never seen, the parent completes on the next parent's first bar (pass 0).
if pairOK and cf
    for pass = 0 to 1
        if pass == 1
            if na(live) or pOpenT != live.t
                pSeq += 1
                live       := PCandle.new(pOpenT, pSeq, open, high, low, close, bar_index, bar_index, bar_index)
                liveClosed := false
            // xC2: the confirmed sequence fails once its C2 extreme trades again. Checked before this
            // bar can complete the parent, so the failing candle is the one this bar belongs to.
            if htfVisDir != 0 and na(htfVisFailSeq) and not na(htfVisC2Ext) and (htfVisDir == 1 ? low < htfVisC2Ext : high > htfVisC2Ext)
                htfVisFailSeq := live.seq
        if not na(live) and not liveClosed and (pass == 0 ? pOpenT != live.t : pEnd)
            liveClosed := true
            array.unshift(parents, live)
            while array.size(parents) > 36
                array.pop(parents)
            PCandle just = array.get(parents, 0)
            if i_pdEngine
                core.f_pdStep(pdCfg, pdS1, core.PDBar.new(just.t, just.o, just.h, just.l, just.c, float(na), bar_index, just.b0))
            // external liquidity: a 3-candle HTF1 swing on the middle candle, confirmed by this close
            if array.size(parents) >= 3
                PCandle swM = array.get(parents, 1)
                PCandle swL = array.get(parents, 2)
                if core.f_swingHi(swL.h, swM.h, just.h)
                    core.f_addHL(pdCfg, swM.h, 1, lblA + " BSL", swM.hiBar, 1)
                if core.f_swingLo(swL.l, swM.l, just.l)
                    core.f_addHL(pdCfg, swM.l, -1, lblA + " SSL", swM.loBar, 1)
            // Only completed owner closes can invert an HTF1 FVG or retire its inverse.
            core.f_pfClose(pfvgs, 1, just.c)
            if array.size(parents) >= 3
                PCandle n = array.get(parents, 0)
                PCandle o = array.get(parents, 2)
                if n.l > o.h
                    core.f_addPFvg(pdCfg, n.l, o.h, 1, o.t, lblA, pass == 1 ? bar_index : bar_index - 1, 1)
                if n.h < o.l
                    core.f_addPFvg(pdCfg, o.l, n.h, -1, o.t, lblA, pass == 1 ? bar_index : bar_index - 1, 1)
            // Fresh C2 takes priority over a C3 closure (TTrades)
            int candDir = 0
            PCandle c1 = na
            PCandle c2 = na
            if array.size(parents) >= 2
                PCandle b = array.get(parents, 0)
                PCandle a = array.get(parents, 1)
                bool bull2 = core.f_c2(1, a.h, a.l, b.h, b.l, b.c)
                bool bear2 = core.f_c2(-1, a.h, a.l, b.h, b.l, b.c)
                if bull2 != bear2
                    candDir := bull2 ? 1 : -1
                    c1 := a
                    c2 := b
            if candDir == 0 and array.size(parents) >= 3
                PCandle b = array.get(parents, 0)
                PCandle p = array.get(parents, 1)
                PCandle a = array.get(parents, 2)
                bool bull3 = core.f_c3(1, a.h, a.l, p.o, p.h, p.l, p.c, b.h, b.l, b.c)
                bool bear3 = core.f_c3(-1, a.h, a.l, p.o, p.h, p.l, p.c, b.h, b.l, b.c)
                if bull3 != bear3
                    candDir := bull3 ? 1 : -1
                    c1 := a
                    c2 := p
            if candDir != 0 and not na(c1) and not na(c2)
                int priorRawDir = htfVisDir
                string paMode = ""
                if priorRawDir != 0
                    paMode := priorRawDir == candDir ? "CONT" : "REV"
                else if parentCisdDir != 0 and not na(parentCisdSeq) and parentCisdSeq <= c1.seq
                    paMode := parentCisdDir == candDir ? "CONT" : "REV"
                htfVisDir     := candDir
                htfVisC2Seq   := c2.seq
                htfVisMode    := paMode
                htfVisC1H     := c1.h
                htfVisC1L     := c1.l
                htfVisC2Ext   := candDir == 1 ? c2.l : c2.h
                htfVisFailSeq := na
            // Engine-off parent path uses the same completed-owner invalidation rule.
            if not i_pdEngine
                // ── parent CISD: only a parent CLOSE beyond the pending anchor confirms it
                int jd = core.f_bodyDir(just.o, just.c)
                // an anchor may confirm only within i_pendMax candles after its run
                bool bullConf = not na(pendBullLvl) and just.seq - pendBullEnd <= i_pendMax and just.c > pendBullLvl
                bool bearConf = not na(pendBearLvl) and just.seq - pendBearEnd <= i_pendMax and just.c < pendBearLvl
                if bullConf and bearConf
                    bullConf := jd == 1
                    bearConf := jd == -1
                if bullConf or bearConf
                    parentCisdDir   := bullConf ? 1 : -1
                    parentCisdLevel := bullConf ? pendBullLvl : pendBearLvl
                    parentCisdFrom  := bullConf ? pendBullFrom : pendBearFrom
                    parentCisdSeq   := just.seq
                    // protected by the swing it confirmed: run extreme + everything printed since
                    parentCisdGuard := bullConf ? math.min(pendBullExt, just.l) : math.max(pendBearExt, just.h)
                    if bullConf
                        usedBullFrom := pendBullFrom
                        pendBullLvl  := na
                    else
                        usedBearFrom := pendBearFrom
                        pendBearLvl  := na
                // Run bookkeeping (a doji continues the run it is in). The latest completed run's open
                // is the pending anchor of the opposite CISD and survives intervening candles.
                int rd = jd == 0 ? runDir : jd
                if rd != 0
                    if rd != runDir
                        runOpen := just.o
                        runFrom := just.b0
                        runExt  := rd == 1 ? just.h : just.l
                    else
                        runExt  := rd == 1 ? math.max(runExt, just.h) : math.min(runExt, just.l)
                    runDir := rd
                    if rd == -1 and runFrom != nz(usedBullFrom, -1)
                        pendBullLvl  := runOpen
                        pendBullFrom := runFrom
                        pendBullExt  := runExt
                        // a doji continues the run but does not extend the anchor life (as in Core)
                        if jd == -1
                            pendBullEnd := just.seq
                    else if rd == 1 and runFrom != nz(usedBearFrom, -1)
                        pendBearLvl  := runOpen
                        pendBearFrom := runFrom
                        pendBearExt  := runExt
                        if jd == 1
                            pendBearEnd := just.seq
                // Protected extremes keep extending until confirmation. An anchor the NEXT parent could
                // no longer confirm (age > i_pendMax) expires now, so it cannot show as forming either.
                if not na(pendBullLvl)
                    pendBullExt := math.min(pendBullExt, just.l)
                    if just.seq + 1 - pendBullEnd > i_pendMax
                        pendBullLvl := na
                if not na(pendBearLvl)
                    pendBearExt := math.max(pendBearExt, just.h)
                    if just.seq + 1 - pendBearEnd > i_pendMax
                        pendBearLvl := na
                if parentCisdDir != 0 and not na(parentCisdGuard) and (parentCisdDir == 1 ? just.c < parentCisdGuard : just.c > parentCisdGuard)
                    parentCisdDir := 0
                    parentCisdLevel := na
                    parentCisdFrom := na
                    parentCisdSeq := na
                    parentCisdGuard := na


// ── HTF2: chart-side tracking, 3-candle swings, completed-candle FVGs ────────
if pairOK and cf and not na(h2OpenT) and (na(h2OpenT[1]) or h2OpenT != h2OpenT[1])
    if not na(h2RunH)
        array.unshift(h2cH, h2RunH)
        array.unshift(h2cL, h2RunL)
        array.unshift(h2cHB, h2RunHB)
        array.unshift(h2cLB, h2RunLB)
        if array.size(h2cH) > 3
            array.pop(h2cH)
            array.pop(h2cL)
            array.pop(h2cHB)
            array.pop(h2cLB)
        // external liquidity: a 3-candle HTF2 swing on the middle candle, confirmed by the one just closed
        if array.size(h2cH) == 3
            if core.f_swingHi(array.get(h2cH, 2), array.get(h2cH, 1), array.get(h2cH, 0))
                core.f_addHL(pdCfg, array.get(h2cH, 1), 1, lblB + " BSL", array.get(h2cHB, 1), 2)
            if core.f_swingLo(array.get(h2cL, 2), array.get(h2cL, 1), array.get(h2cL, 0))
                core.f_addHL(pdCfg, array.get(h2cL, 1), -1, lblB + " SSL", array.get(h2cLB, 1), 2)
    h2RunH := high
    h2RunL := low
    h2RunHB := bar_index
    h2RunLB := bar_index
else if pairOK and cf and not na(h2RunH)
    if high > h2RunH
        h2RunH := high
        h2RunHB := bar_index
    if low < h2RunL
        h2RunL := low
        h2RunLB := bar_index

if newB and cf
    core.f_pfClose(pfvgs, 2, bC1)
    if not na(bH3) and not na(bL3)
        if bL1 > bH3
            core.f_addPFvg(pdCfg, bL1, bH3, 1, bT3, lblB, bar_index - 1, 2)
        if bH1 < bL3
            core.f_addPFvg(pdCfg, bL3, bH1, -1, bT3, lblB, bar_index - 1, 2)

if cf
    // HTF gap tap: the owner-close inversion itself cannot count as an inverse retest.
    for z in pfvgs
        if z.state == 0 and bar_index > nz(z.invertedAt, z.conf) and low <= z.top and high >= z.bot
            z.state := 1
    int parentSeen = 0
    for l in hls
        if l.src == 1
            parentSeen += 1
            if parentSeen > i_hlKeepParent
                l.state := 1
    // internal pivots -> MSS candidates
    if not na(iph)
        array.push(iHp, iph)
        array.push(iHi, bar_index - i_intLen)
        if array.size(iHp) > 30
            array.shift(iHp)
            array.shift(iHi)
    if not na(ipl)
        array.push(iLp, ipl)
        array.push(iLi, bar_index - i_intLen)
        if array.size(iLp) > 30
            array.shift(iLp)
            array.shift(iLi)
// Native PD streams run before the narrative selects its arrays and draws. The chart stream also
// runs for the narratives alone: they read their OB and breaker there.
if i_pdEngine and cf
    if pdFallback and not na(pdNative1)
        // the completed Daily candle is anchored on its own first chart bar (dayB0 still holds it here)
        core.f_pdStep(pdCfg, pdS1, core.PDBar.new(pdNative1.t, pdNative1.o, pdNative1.h, pdNative1.l, pdNative1.c, nz(pdNative1.a, pdNative1.h - pdNative1.l), bar_index, nz(dayB0, bar_index)))
    if pdHasParent and not na(pdNative2)
        core.f_pdStep(pdCfg, pdS2, core.PDBar.new(pdNative2.t, pdNative2.o, pdNative2.h, pdNative2.l, pdNative2.c, nz(pdNative2.a, pdNative2.h - pdNative2.l), bar_index))
// One confirmed parent state for paired and Daily fallback paths. The stream advances
// only on completed owner candles, so an interim chart close cannot release / restore it.
if cf and i_pdEngine and pdHasParent
    parentCisdDir := pdS1.cisDir
    parentCisdLevel := pdS1.cisLevel
    parentCisdFrom := pdS1.cisFrom
    parentCisdSeq := pdS1.cisSeq
    pendBullLvl := pdS1.dnArmed and pdS1.seq + 1 - pdS1.dnEnd <= i_pendMax ? pdS1.dnOpen : na
    pendBullFrom := pdS1.dnFrom
    pendBearLvl := pdS1.upArmed and pdS1.seq + 1 - pdS1.upEnd <= i_pendMax ? pdS1.upOpen : na
    pendBearFrom := pdS1.upFrom
if cf and (i_pdEngine or i_seqOn)
    core.f_pdStep(pdCfg, pdS0, core.PDBar.new(time, open, high, low, close, atrS, bar_index))
if i_pdEngine and cf
    if i_pdOpenGaps and timeframe.isintraday and not na(close[1]) and math.abs(open - close[1]) >= tick
        int gapDir = open > close[1] ? 1 : -1
        if pdNewDay
            core.f_pdAdd(pdCfg, pdS0, "NDOG", gapDir, math.max(open, close[1]), math.min(open, close[1]), time, pdS0.impulse, 0, false, float(na))
        if pdNewWeek
            core.f_pdAdd(pdCfg, pdS0, "NWOG", gapDir, math.max(open, close[1]), math.min(open, close[1]), time, pdS0.impulse, 0, false, float(na))
    // Timestamp-matched comparisons only; unrelated trading hours never imply SMT.
    bool cmpOK = i_pdSmt and not na(pdCmpT[1]) and pdCmpT[1] == time[1] and not na(pdCmpH[1]) and not na(pdCmpL[1])
    if cmpOK and not na(high[2])
        if core.f_swingHi(high[2], high[1], high)
            if not na(pdSmtHi) and high[1] > pdSmtHi and pdCmpH[1] <= pdSmtCmpHi
                pdSmtDir := -1
                pdSmtAt := bar_index
            pdSmtHi := high[1]
            pdSmtCmpHi := pdCmpH[1]
        if core.f_swingLo(low[2], low[1], low)
            if not na(pdSmtLo) and low[1] < pdSmtLo and pdCmpL[1] >= pdSmtCmpLo
                pdSmtDir := 1
                pdSmtAt := bar_index
            pdSmtLo := low[1]
            pdSmtCmpLo := pdCmpL[1]


bool htfVisAlive = htfVisDir != 0 and na(htfVisFailSeq) and not na(live) and live.seq - htfVisC2Seq + 2 <= 4

// ── HTF continuation: the live HTF1 candle holding beyond the previous candle's body 50% arms
// continuation setups on the raw arrays. Context only, like every other mode: nothing is gated.
if cf and not na(dayOpenT) and (na(dayOpenT[1]) or dayOpenT != dayOpenT[1])
    dayB0 := bar_index
if cf
    int contWas = contDir
    contDir := 0
    contMid := na
    if i_cont and pairOK and not na(live)
        int cpK = liveClosed ? 1 : 0
        if array.size(parents) > cpK
            PCandle cpv = array.get(parents, cpK)
            int cpd = core.f_bodyDir(cpv.o, cpv.c)
            contMid  := (cpv.o + cpv.c) / 2
            contFrom := live.b0
            contDir  := cpd == 1 and live.c > contMid ? 1 : cpd == -1 and live.c < contMid ? -1 : 0
    else if i_cont and not pairOK and chSec < 86400 and not na(dayPrevO) and not na(dayPrevC)
        // no valid pairing: confirmed chart close against the confirmed prior Daily body 50%
        int dpd = core.f_bodyDir(dayPrevO, dayPrevC)
        contMid  := (dayPrevO + dayPrevC) / 2
        contFrom := dayB0
        contDir  := dpd == 1 and close > contMid ? 1 : dpd == -1 and close < contMid ? -1 : 0
    // with the PD engine, only the legacy CONT mode fires here; the causal modes set the event below
    if contDir != 0 and contDir != contWas and (not i_pdEngine or i_pdCont == "Legacy body 50%")
        array.set(ev, EV_CONT + (contDir == 1 ? 0 : 1), true)

// Preserve the legacy body midpoint as labelled context; causal CONT uses events.
if cf
    pdContSignal := 0
    if i_cont and i_pdEngine
        int d = pdContext.cont
        bool localShift = d != 0 and pdS0.cisDir == d and not na(pdS0.cisBar) and pdS0.cisBar >= pdContext.contBar
        core.PDArr localArray = d != 0 ? core.f_pdEntry(pdCfg, d, nz(pdContext.contBar, bar_index), true) : na
        bool qualify = d != 0 and (i_pdCont == "Response" or (localShift and (i_pdCont != "Response + local CISD + FVG" or (not na(localArray) and (localArray.kind == "FVG" or localArray.kind == "iFVG")))))
        if qualify and f_pdAllowed(d)
            pdContSignal := d
        if i_pdCont != "Legacy body 50%"
            array.set(ev, EV_CONT, pdContSignal == 1 and pdContSignal[1] != 1)
            array.set(ev, EV_CONT + 1, pdContSignal == -1 and pdContSignal[1] != -1)
            contDir := pdContSignal

// ── CISD+ map streams ────────────────────────────────────────────────────────
if i_cisdMap and cf
    for si = 0 to 2
        core.CMapStrm s = array.get(cMapStreams, si)
        if s.act
            core.f_cmBar(cmReg, s, si == 0 ? true : si == 1 ? cL1New : cL2New, si == 0 ? true : si == 1 ? cL1End : cL2End)
    int ncx = array.size(cMapCises)
    if ncx > 0
        for i = ncx - 1 to 0
            core.CMapCis x = array.get(cMapCises, i)
            if bar_index > x.atB and (x.dir == 1 ? low < x.ext : high > x.ext)
                core.f_cmDrop(cmReg, i)

// ── (3) HTF1 swing taken this bar -> grab events (ICY state engine) ───────────
// Only the nearest HTF1 swings may start a narrative; a grouped HTF2 swing joins the pool's
// name only. DRAW slot reservations and distance caps affect the display, not grab eligibility.
float hlTol  = atrS * i_hlClusterAtr
float hlTol2 = atrS * i_h2Near
float hlRef = nz(close[1], close)
int hiSel1 = core.f_hlBest(pdCfg, 1, float(na), hlTol, hlRef)
float hiSel1Px = hiSel1 >= 0 ? array.get(hls, hiSel1).price : na
int hiSel2 = i_hlPerSide > 1 ? core.f_hlBest(pdCfg, 1, hiSel1Px, hlTol, hlRef) : -1
int loSel1 = core.f_hlBest(pdCfg, -1, float(na), hlTol, hlRef)
float loSel1Px = loSel1 >= 0 ? array.get(hls, loSel1).price : na
int loSel2 = i_hlPerSide > 1 ? core.f_hlBest(pdCfg, -1, loSel1Px, hlTol, hlRef) : -1
float  evSslPx = na
string evSslNm = ""
int    evSslKd = -1
int    evSslIx = na
float  evBslPx = na
string evBslNm = ""
int    evBslKd = -1
int    evBslIx = na
int nHL = array.size(hls)
if cf and nHL > 0
    for k = 0 to nHL - 1
        core.HLvl l = array.get(hls, k)
        if l.state == 0 and bar_index > l.bornBar
            bool taken = l.dir == 1 ? high > l.price : low < l.price
            if taken
                bool selected = l.dir == 1 ? (k == hiSel1 or k == hiSel2) : (k == loSel1 or k == loSel2)
                bool qualifies = i_sweep == "Any Breach" or (l.dir == 1 ? close < l.price : close > l.price)
                if selected and qualifies
                    int seedK = l.dir == 1 ? (k == hiSel1 ? hiSel1 : hiSel2) : (k == loSel1 ? loSel1 : loSel2)
                    [cn, _, _] = core.f_hlCluster(pdCfg, seedK, hlTol, hlTol2, float(na), 0)
                    if l.dir == 1
                        if na(evBslPx) or l.price > evBslPx
                            evBslPx := l.price
                            evBslNm := cn == "" ? l.name : cn
                            evBslKd := l.src
                            evBslIx := l.bornBar
                    else
                        if na(evSslPx) or l.price < evSslPx
                            evSslPx := l.price
                            evSslNm := cn == "" ? l.name : cn
                            evSslKd := l.src
                            evSslIx := l.bornBar
    for l in hls
        if l.state == 0 and bar_index > l.bornBar and (l.dir == 1 ? high > l.price : low < l.price)
            l.state := 1

// ── (5) chart-TF FVG registry ────────────────────────────────────────────────
bool gUp = not na(high[2]) and low > high[2] and low - high[2] >= i_fvgMin * atrS
bool gDn = not na(low[2]) and high < low[2] and low[2] - high >= i_fvgMin * atrS
if cf and (gUp or gDn)
    int   gd = gUp ? 1 : -1
    float gt = gUp ? low : low[2]
    float gb = gUp ? high[2] : high
    FVG nf = FVG.new(gd, gt, gb, bar_index - 1, bar_index, origin = time[1])
    // SIBI / BISI: the three candles that print the gap all close in its direction
    nf.sib := gUp ? (close > open and close[1] > open[1] and close[2] > open[2]) : (close < open and close[1] < open[1] and close[2] < open[2])
    Seq own = gd == 1 ? bullSeq : bearSeq
    if i_seqOn and not na(own) and own.stage >= 3 and own.stage <= 4
        nf.role  := 2
        nf.owner := own
    array.push(fvgs, nf)
    f_fvgBox(nf)
    while array.size(fvgs) > FVG_CAP
        f_fvgRetire(array.shift(fvgs))

int nF = array.size(fvgs)
if cf and nF > 0
    for k = nF - 1 to 0
        FVG f = array.get(fvgs, k)
        if bar_index > f.born
            float ce = (f.top + f.bot) / 2
            if f.state == 0
                bool touch = f.dir == 1 ? low <= f.top : high >= f.bot
                if touch
                    f.state    := 1
                    f.touchIdx := bar_index
                    f_fvgEdge(f, bar_index)
                    bool shallow = f.dir == 1 ? low > ce : high < ce
                    if i_iofed and f.role == 2 and f.sib and shallow and not na(f.owner)
                        Seq ow = f.owner
                        if not ow.dead and ow.stage <= 4 and ow.nIofed < MAX_MARKS
                            float lvI = f.dir == 1 ? f.top : f.bot
                            array.push(ow.N, core.f_newLine(f.idx, lvI, bar_index, lvI, C_IOFED, ST_IOFED, W_IOFED, false))
                            array.push(ow.L, core.f_newLabel(bar_index, lvI, (f.dir == 1 ? "+" : "-") + "IOFED", label.style_label_left, NOCOL, C_IOFED, size.tiny, "", false))
                            ow.nIofed := ow.nIofed + 1
            if f.state <= 1
                bool inv = f.dir == 1 ? close < f.bot : close > f.top
                if inv
                    f.state  := 2
                    f.invIdx := bar_index
                    // The old entry classification describes the former polarity / dealing leg.
                    // Restyle the inverted gap as raw PA; role still protects an owned entry array.
                    f.isEntry := false
                    f.pd      := ""
                    f.fz      := false
                    Seq qs = f.dir == 1 ? bearSeq : bullSeq
                    if i_seqOn and f_canClaimIfvg(f, qs)
                        f_claimIfvg(f, qs)
                    f_fvgBox(f)
            else if f.state == 2
                bool kill = f.dir == 1 ? close > f.top : close < f.bot
                if kill
                    f.state   := 3
                    f.killIdx := bar_index
                    f_fvgEdge(f, bar_index)
        if bar_index - f.born > FVG_AGE
            f_fvgRetire(f)
            array.remove(fvgs, k)

// Delivery gaps classify OLDEST first, while their narrative is live: the first gap left untouched
// for i_bgBars breaks away, later ones measure (ICY). Marks never appear on a resolved narrative.
if cf and i_bg
    for f in fvgs
        if f.role == 2 and f.sib and f.state == 0 and not f.bg and not f.mg and bar_index - f.born >= i_bgBars and not na(f.owner)
            Seq ob = f.owner
            if not ob.dead and ob.stage <= 4 and ob.nBg < MAX_MARKS
                if ob.nBg == 0
                    f.bg := true
                else
                    f.mg := true
                ob.nBg := ob.nBg + 1
                f_fvgBox(f)

// ── (2) liquidity generation / accumulation ranges ───────────────────────────
if cf and i_accMode != "Off"
    float capNow = i_accMult * nz(atrA, atrS)
    if not acc.on
        if bar_index >= i_accLen and not na(accHH) and not na(accLL) and accHH - accLL <= capNow
            acc.on  := true
            acc.s   := bar_index - i_accLen + 1
            acc.t   := accHH
            acc.b   := accLL
            acc.cap := capNow
            acc.bx  := core.f_newBox(acc.s, acc.t, bar_index, acc.b, color.new(C_ACC, 45), f_arrayFill(C_ACC, 1.0), ST_ACC, false, "Liquidity Generation", C_TXT, true, false)
    else
        bool  brk = close > acc.t or close < acc.b
        float nT  = math.max(acc.t, high)
        float nB2 = math.min(acc.b, low)
        if brk or nT - nB2 > acc.cap * 1.25
            acc.on := false
            box.set_right(acc.bx, bar_index - 1)
            if not na(acc.lastBx) and not acc.lastClaimed
                if i_accMode == "All"
                    f_fzBox(acc.lastBx)
                else
                    box.delete(acc.lastBx)
            acc.lastBx      := acc.bx
            acc.lastClaimed := false
            acc.lastS       := acc.s
            acc.lastE       := bar_index - 1
            acc.bx          := na
        else
            acc.t := nT
            acc.b := nB2
            box.set_top(acc.bx, nT)
            box.set_bottom(acc.bx, nB2)

// ── (3)-(8) narrative sequences ──────────────────────────────────────────────
if cf
    f_pruneHistory()
if cf and histDays > 0
    if not na(bullSeq) and (na(bullSeq.sweepTime) or bullSeq.sweepTime < setupStart)
        int oldBullId = bullSeq.id
        f_seqDelete(bullSeq)
        if not na(lastBull) and lastBull.id == oldBullId
            lastBull := na
        bullSeq := na
    if not na(bearSeq) and (na(bearSeq.sweepTime) or bearSeq.sweepTime < setupStart)
        int oldBearId = bearSeq.id
        f_seqDelete(bearSeq)
        if not na(lastBear) and lastBear.id == oldBearId
            lastBear := na
        bearSeq := na
    if not na(lastBull) and (na(lastBull.sweepTime) or lastBull.sweepTime < setupStart)
        lastBull := na
    if not na(lastBear) and (na(lastBear.sweepTime) or lastBear.sweepTime < setupStart)
        lastBear := na

// A grab starts a narrative when the side is idle; a live narrative consumes the deeper grab.
// One step call site for both sides (bull first, as before): the step inlines the whole narrative.
if cf and i_seqOn
    for side = 0 to 1
        float  gPx   = side == 0 ? evSslPx : evBslPx
        string gNm   = side == 0 ? evSslNm : evBslNm
        int    gKd   = side == 0 ? evSslKd : evBslKd
        Seq    sq    = side == 0 ? bullSeq : bearSeq
        bool   isNew = setupWindow and na(sq) and not na(gPx)
        if isNew
            seqN += 1
            sq := f_newSeq(side == 0 ? 1 : -1, gPx, gNm, gKd, seqN, side == 0 ? evSslIx : evBslIx)
            array.set(ev, EV_GRAB + side, true)
        if not na(sq)
            sq.step(acc, not isNew and not na(gPx), gPx, gNm, gKd)
            if sq.stage >= 2 and sq.result != 9
                if side == 0
                    lastBull := sq
                else
                    lastBear := sq
            if sq.stage == 5
                sq := na
        if side == 0
            bullSeq := sq
        else
            bearSeq := sq

if cf and i_pdEngine
    f_pruneDone()
f_pdStudy()

// =============================================================================
// 10 · LAST BAR — context renderer, on-chart C-sequence, HUD, legend
// =============================================================================
f_findParent(int seq) =>
    PCandle out = na
    if not na(live) and live.seq == seq
        out := live
    else
        for c in parents
            if c.seq == seq
                out := c
                break
    out

// C1 · C2 · C3 · C4 tags on the chart, at each parent candle's protective extreme
f_drawChartCTags() =>
    for k = 0 to 3
        label lb = array.get(chartCTags, k)
        int cn = k + 1
        bool show = i_chartC and pairOK and htfVisDir != 0 and not na(htfVisC2Seq) and (na(htfVisFailSeq) or htfVisC2Seq + cn - 2 <= htfVisFailSeq)
        PCandle c = na
        if show
            c := f_findParent(htfVisC2Seq + cn - 2)
        if show and not na(c) and cn <= (na(live) ? 4 : math.min(4, live.seq - htfVisC2Seq + 2))
            bool failed = not na(htfVisFailSeq) and c.seq == htfVisFailSeq
            string tx = "C" + str.tostring(cn) + (htfVisMode != "" ? " " + htfVisMode : "") + (failed ? " ✕" : "")
            float y = htfVisDir == 1 ? c.l : c.h
            int x = core.f_past(htfVisDir == 1 ? c.loBar : c.hiBar)
            lb := core.f_label(lb, x, y, tx, color.new(htfVisDir == 1 ? C_BULL : C_BEAR, failed ? 45 : 15), htfVisDir == 1 ? label.style_label_up : label.style_label_down, size.tiny)
        else
            lb := core.f_hideLabel(lb)
        array.set(chartCTags, k, lb)
    true

f_stateTxt(Seq s) =>
    string r = "IDLE"
    if not na(s)
        r := s.stage == 1 ? "GRAB" : s.stage == 2 ? "SHIFT" : s.stage == 3 ? "ARRAY" : s.stage == 4 ? "DELIVERY" : s.result == 1 ? "✓ DRAW" : s.result == -1 ? "✕ FAIL" : s.result == 7 ? "AMBIG" : s.result == 2 ? "MISSED" : s.result == 3 ? "EXPIRED" : s.result == 4 ? "INVALID" : s.result == 5 ? "NO ARRAY" : s.result == 6 ? "TIMEOUT" : "—"
    r

f_stateCol(Seq s) =>
    color c = #787B86
    if not na(s)
        c := s.stage < 5 ? C_SHIFT : s.result == 1 ? C_WIN : s.result == -1 ? C_LOSS : #787B86
    c

// first owner of a clustered name: "15m L + 1H L" -> "15m L+"
f_short(string nm) =>
    int k = str.pos(nm, " + ")
    na(k) ? nm : str.substring(nm, 0, k) + "+"

f_side(Seq s) =>
    string h  = "—"
    string a  = "—"
    string g  = "—"
    string sh = "—"
    string ar = "—"
    string mm = "—"
    string dr = "—"
    if not na(s)
        h  := s.htf ? f_short(s.htfName) : "—"
        a  := s.acc ? "✓" : "—"
        g  := f_short(s.poolName)
        sh := s.stage >= 2 and s.shiftType != "" ? s.shiftType + (s.hasIfvg ? "·iFVG" : "") : s.stage == 1 ? "…" : "—"
        ar := s.arrName != "" ? str.replace_all(str.replace_all(s.arrName, " · Leg Discount", "·legD"), " · Leg Premium", "·legP") + (not na(s.tapIdx) ? " ✓" : "") : "—"
        mm := s.stage == 1 ? "…" : s.mmxm ? (s.dir == 1 ? "MMBM" : "MMSM") : "raw"
        dr := s.drawName == "" ? "—" : f_short(s.drawName) + (s.result == 1 ? " ✓" : "")
    [h, a, g, sh, ar, mm, dr]

// Statistics come from the outcome ledger (every resolved narrative inside the setup window),
// never from the drawing-retention cap. Ambiguous outcomes are neither wins nor losses.
f_histCounts(int sd) =>
    int wantDir = sd == 0 ? 1 : -1
    int m = 0
    int w = 0
    int l = 0
    int mi = 0
    int ex = 0
    int am = 0
    int n = array.size(ledT)
    if n > 0
        for i = 0 to n - 1
            if array.get(ledD, i) == wantDir and (histDays == 0 or array.get(ledT, i) >= setupStart)
                int r = array.get(ledR, i)
                m += 1
                if r == 1
                    w += 1
                else if r == -1
                    l += 1
                else if r == 2
                    mi += 1
                else if r == 7
                    am += 1
                else
                    ex += 1
    Seq lv = sd == 0 ? bullSeq : bearSeq
    if not na(lv) and lv.stage >= 2 and lv.stage <= 4
        m += 1
    [m, w, l, mi, ex, am]

f_tallyTxt(int sd) =>
    [m, w, l, mi, ex, am] = f_histCounts(sd)
    string pc = w + l > 0 ? str.tostring(math.round(100.0 * w / (w + l))) + "%" : "—"
    [str.tostring(m) + "·" + str.tostring(w) + "·" + str.tostring(l) + " " + pc, str.tostring(mi) + "·" + str.tostring(ex) + "·" + str.tostring(am)]

f_pdVisible(core.PDArr a) =>
    bool narrativeBB = i_showBrk and ((f_seqLive(bullSeq) and bullSeq.pdBbId == a.id) or (f_seqLive(bearSeq) and bearSeq.pdBbId == a.id))
    a.kind == "OB" ? i_pdOb : a.kind == "BB" ? i_pdBb or narrativeBB : a.kind == "BPR" ? i_pdBpr : a.kind == "RB" ? i_pdRb : a.kind == "MB" ? i_pdMb : a.kind == "VI" ? i_pdVi : a.kind == "VOID?" ? i_pdVoid : a.kind == "IFG?" ? i_pdImplied : a.kind == "ROB?" ? i_pdReclaim : a.kind == "NDOG" or a.kind == "NWOG" ? i_pdOpenGaps : false

// Primary slots are independent of the supporting-zone budget and raw registry age.
// The selected bounds, retest, invalidation and draw remain fixed engine outputs.
f_focusPrimary() =>
    for side = 0 to 1
        Seq s = side == 0 ? bullSeq : bearSeq
        bool active = i_focus and f_seqLive(s)
        box bx = array.get(focusBoxes, side)
        bool reaction = active and s.stage >= 3
        bool ob = reaction and str.contains(s.arrName, "OB")
        bool showReaction = reaction and i_showEntry and (ob or i_fvgMode != "Off")
        core.PDArr entry = reaction ? s.pdEntryRef : na
        core.PDArr target = reaction ? core.f_pdById(pdS1, s.pdDrawId) : na
        core.PDArr obstacle = reaction and i_pdEngine and i_pdObstacle ? core.f_pdNear(pdCfg, s.dir, close, true, -1) : na
        float obstaclePx = na(obstacle) ? na : s.dir == 1 ? math.max(close, obstacle.bot) : math.min(close, obstacle.top)
        bool drawIsObstacle = reaction and not na(obstaclePx) and math.abs(obstaclePx - s.drawPx) < tick * 0.5
        color col = not na(entry) and entry.state >= 4 ? C_GREY : side == 0 ? C_ARRB : C_ARR
        string overlaps = ""
        if showReaction
            for stream in pdStreams
                if stream.src == 0 or (i_pdEngine and pdHasParent)
                    for a in stream.A
                        if a.id != s.pdEntryId and f_pdVisible(a) and f_focusKind(a) and f_focusOverlap(a, s)
                            overlaps += "\n" + core.f_pdName(pdCfg, a) + " · " + core.f_pdState(a.state) + " [" + str.tostring(a.bot, format.mintick) + "–" + str.tostring(a.top, format.mintick) + "]"
            if s.pdBprId == 0 and not na(s.bxBpr)
                overlaps += "\nBPR overlap [" + str.tostring(box.get_bottom(s.bxBpr), format.mintick) + "–" + str.tostring(box.get_top(s.bxBpr), format.mintick) + "]; response not tracked."
        if showReaction and not ob
            if na(bx)
                bx := core.f_newBox(core.f_past(s.arrIdx), s.arrTop, bar_index, s.arrBot, color.new(col, 55), f_arrayFill(col, 1.0), ST_ENTRY, false, "", C_TXT, false, false)
            else
                box.set_lefttop(bx, core.f_past(s.arrIdx), s.arrTop)
                box.set_rightbottom(bx, bar_index, s.arrBot)
                box.set_border_color(bx, color.new(col, 55))
                box.set_bgcolor(bx, f_arrayFill(col, 1.0))
        else
            bx := core.f_hideBox(bx)
        array.set(focusBoxes, side, bx)
        for role = 0 to 4
            int slot = side * 5 + role
            line ln = array.get(focusLines, slot)
            label lb = array.get(focusLabels, slot)
            bool shown = active and (role == 0 ? i_showGrab : role == 1 ? i_showInv : role == 2 ? reaction and i_showDraw : role == 3 ? showReaction : i_cleanLabels and i_showMss and s.stage >= 2 and s.shiftType == "MSS" and not na(s.mssLvl))
            if shown
                float px = role == 0 ? s.poolPx : role == 1 ? (reaction ? s.invPx : s.ext - s.dir * i_stopPad * tick) : role == 2 ? s.drawPx : role == 4 ? s.mssLvl : ob ? s.rtPx : (s.arrTop + s.arrBot) / 2
                int left = core.f_past(role == 0 ? s.sweepIdx : role == 1 ? s.extIdx : role == 2 ? s.pubIdx : role == 4 ? s.mssIdx : s.arrIdx)
                int right = role == 0 ? core.f_past(math.min(bar_index, s.sweepIdx + GAP_LEN)) : role == 3 ? bar_index : bar_index + i_right
                color ink = role == 0 ? C_GRAB : role == 1 ? C_INV : role == 2 ? C_DRAW : role == 4 ? C_MSS : col
                string caption = role == 0 ? s.poolName + " taken" : role == 1 ? (reaction ? "Invalidation" : "Grab guard") : role == 2 ? "DRAW · " + (na(target) ? s.drawName : core.f_pdName(pdCfg, target)) : role == 4 ? (s.dir == 1 ? "↑ " : "↓ ") + core.f_tfLbl(timeframe.period) + " MSS" : i_pdTag ? s.arrName : str.replace(str.replace(s.arrName, " · Leg Discount", ""), " · Leg Premium", "")
                if role == 3
                    caption := str.replace(caption, " · Leg ", " · ")
                if role == 3 and overlaps != ""
                    caption += " · overlap"
                if role == 2 and drawIsObstacle
                    caption += " · nearest obstacle"
                if role == 1 or role == 2
                    caption := (s.dir == 1 ? "↑ " : "↓ ") + caption
                if role != 3 or ob or i_fvgCe
                    ln := core.f_line(ln, left, px, right, px, role == 3 ? color.new(ink, 60) : ink, role == 0 ? ST_GRAB : role == 1 ? ST_INV : role == 2 ? ST_DRAW : role == 4 ? ST_MSS : ob ? ST_OB : ST_CE, role == 0 ? W_GRAB : role == 1 ? W_INV : role == 2 ? W_DRAW : role == 4 ? W_MSS : ob ? W_OB : W_CE)
                else
                    ln := core.f_hideLine(ln)
                if role != 3 or ob or i_fvgLbl
                    lb := core.f_label(lb, right + i_lblGap, px, caption, ink, label.style_label_left, role == 3 ? FSZ : size.tiny)
                    string tip = role == 0 ? "Active narrative's swept liquidity. Grouped HTF labels describe location, not independent confirmations." : role == 1 ? (reaction ? "Fixed narrative invalidation from publication." : "Provisional guard follows the grab extreme until publication.") : role == 2 ? "Selected " + s.drawKind + " target. Not reselected by display priority.\n" + core.f_pdTip(pdCfg, core.f_pdById(pdS1, s.pdDrawId), i_tz) : role == 4 ? "Active narrative market-structure shift at " + str.tostring(s.mssLvl, format.mintick) + ". The line retains the original confirmed level." : "Selected reaction; retest " + str.tostring(s.rtPx, format.mintick) + ". " + (na(s.tapIdx) ? "Awaiting retest." : "Retested; delivery active.") + "\n" + core.f_pdTip(pdCfg, entry, i_tz) + (overlaps == "" ? "" : "\nLive related overlaps (original bounds retained):" + overlaps + "\nOne price area, not independent confirmations. The overlap does not move the selected retest.")
                    if role == 2 and drawIsObstacle
                        tip += "\nThe nearest opposing array shares this price:\n" + core.f_pdTip(pdCfg, obstacle, i_tz)
                    label.set_tooltip(lb, tip)
                else
                    lb := core.f_hideLabel(lb)
            else
                ln := core.f_hideLine(ln)
                lb := core.f_hideLabel(lb)
            array.set(focusLines, slot, ln)
            array.set(focusLabels, slot, lb)
        // Focus uses the same selected geometry above; suppress its older context duplicates.
        if active
            if not na(s.lnOb)
                line.set_color(s.lnOb, NOCOL)
                label.set_textcolor(s.lbOb, NOCOL)
            if not na(s.lnBrk)
                line.set_color(s.lnBrk, NOCOL)
                label.set_textcolor(s.lbBrk, NOCOL)
            if not na(s.bxBpr)
                box.set_bgcolor(s.bxBpr, NOCOL)
                box.set_border_color(s.bxBpr, NOCOL)
                box.set_text_color(s.bxBpr, NOCOL)
    true

// At most one live shift/delivery gap per narrative, separate from its reaction.
// A CONT array remains usable when that side has no selected narrative reaction.
f_focusGap(FVG f, bool continuation) =>
    // a switched-off iFVG stays hidden; the gap is still the narrative's footprint / CONT context
    if f.state < 2 or i_showIfvg
        int x1 = core.f_past(f.idx)
        int x2 = continuation ? bar_index : math.min(bar_index, f.idx + GAP_LEN)
        color col = f.state == 2 ? C_IFVG : f.bg or f.mg ? C_BG : f.dir == 1 ? C_FVGB : C_FVGS
        if not na(f.bx)
            box.set_left(f.bx, x1)
            box.set_right(f.bx, x2)
            box.set_bgcolor(f.bx, f_arrayFill(col, continuation ? 0.7 : 0.4))
            box.set_border_color(f.bx, color.new(col, continuation ? 65 : 80))
        if not na(f.ce)
            line.set_x1(f.ce, x1)
            line.set_x2(f.ce, x2)
            line.set_color(f.ce, color.new(col, continuation ? 60 : 82))
        if not na(f.lb)
            label.set_x(f.lb, x2 + i_lblGap)
            label.set_text(f.lb, f_fvgText(f) + (continuation ? " · CONT" : ""))
            label.set_textcolor(f.lb, color.new(col, continuation ? 0 : 40))
            label.set_tooltip(f.lb, "Original formation known at bar " + str.tostring(f.born) + (f.state == 2 ? "; inversion active from " + str.tostring(f.invIdx) : "") + ". " + (continuation ? "Selected continuation context." : "Supporting shift / delivery footprint; not another entry."))
    true


// Select sidebar captions independently of box lifetime and engine eligibility.
f_sideGapLabels(int continuationIx) =>
    array<label> captions = array.new<label>()
    array<int> picked = array.new_int()
    int n = array.size(fvgs)
    if i_cleanLabels and n > 0
        // Each live reaction and one shift/delivery footprint keep priority over raw context.
        for side = 0 to 1
            Seq s = side == 0 ? bullSeq : bearSeq
            int footprint = -1
            float footprintDistance = na
            if f_seqLive(s)
                for i = 0 to n - 1
                    FVG f = array.get(fvgs, i)
                    bool owned = not na(f.owner) and f.owner.id == s.id
                    bool visible = f.sty > 0 and not na(f.lb) and not na(f.bx) and (f.state < 2 or i_showIfvg or f.isEntry)
                    int polarity = f.state >= 2 ? -f.dir : f.dir
                    if owned and visible
                        if f.isEntry and not i_focus and i_showEntry
                            array.push(picked, i)
                        else if not f.isEntry and f.sty == 1 and i_focusExtra > 0 and f.state < 3 and polarity == s.dir and (na(s.arrIdx) or f.idx != s.arrIdx) and (s.stage == 4 ? f.bg or f.mg : f.role == 3)
                            float distance = math.max(0.0, math.max(f.bot - close, close - f.top))
                            if na(footprintDistance) or distance < footprintDistance
                                footprint := i
                                footprintDistance := distance
            if footprint >= 0
                array.push(picked, footprint)
        // Keep the renderer's selected CONT context ahead of supplementary raw gaps.
        if continuationIx >= 0 and continuationIx < n and not array.includes(picked, continuationIx)
            FVG continuation = array.get(fvgs, continuationIx)
            if not na(continuation.lb) and not na(continuation.bx) and (continuation.state < 2 or i_showIfvg)
                array.push(picked, continuationIx)
        // Only unclaimed, nearby raw gaps supplement the narrative. Historical owners stay local.
        if i_sideRaw and i_fvgMode == "Raw PA" and (not i_focus or i_focusRaw)
            for side = 0 to 1
                int polarity = side == 0 ? 1 : -1
                for slot = 1 to i_sideRawMax
                    int best = -1
                    float bestDistance = na
                    for i = 0 to n - 1
                        FVG f = array.get(fvgs, i)
                        int direction = f.state >= 2 ? -f.dir : f.dir
                        float distance = math.max(0.0, math.max(f.bot - close, close - f.top))
                        bool onSide = polarity == 1 ? f.bot <= close : f.top >= close
                        bool eligible = f.sty == 1 and f.state < 3 and not f.isEntry and na(f.owner) and not na(f.lb) and not na(f.bx) and (f.state < 2 or i_showIfvg)
                        if eligible and direction == polarity and onSide and distance <= atrS * i_sideNear and not array.includes(picked, i)
                            if na(bestDistance) or distance < bestDistance
                                best := i
                                bestDistance := distance
                    if best >= 0 and array.size(picked) < array.size(sideGapGuides)
                        array.push(picked, best)
        for i = 0 to n - 1
            FVG f = array.get(fvgs, i)
            if not na(f.lb)
                if array.includes(picked, i)
                    bool primary = not na(f.owner) and f_seqLive(f.owner)
                    bool continuation = i == continuationIx
                    int direction = f.state >= 2 ? -f.dir : f.dir
                    bool failed = f.state == 3 or (f.isEntry and primary and direction != f.owner.dir)
                    color ink = failed or f.state == 1 ? C_GREY : primary or continuation ? (direction == 1 ? C_ARRB : C_ARR) : color.new(C_DIM, 15)
                    string kind = f.state >= 2 ? "iFVG" : f.bg ? "BG" : f.mg ? "MG" : "FVG"
                    string role = continuation ? "CONT" : primary ? (f.isEntry ? "REACTION" : f.bg or f.mg ? "DELIVERY" : "SHIFT") : "PA"
                    string caption = role + " · " + core.f_tfLbl(timeframe.period) + (direction == 1 ? " +" : " -") + kind + (failed ? " · failed" : f.state == 1 ? " · tested" : "")
                    float price = math.avg(f.top, f.bot)
                    label.set_xy(f.lb, bar_index + i_right + i_lblGap, price)
                    label.set_text(f.lb, caption)
                    label.set_textcolor(f.lb, ink)
                    label.set_tooltip(f.lb, (continuation ? "Selected continuation context: " : primary ? "Active narrative " : "Nearby Raw PA ") + f_fvgText(f) + "\nBounds: " + str.tostring(f.bot, format.mintick) + "–" + str.tostring(f.top, format.mintick) + ". Midpoint: " + str.tostring(price, format.mintick) + ".\nFormation known at bar " + str.tostring(f.born) + (f.state >= 2 ? "; inversion from " + str.tostring(f.invIdx) : "") + ". Display selection does not change entry or draw selection.")
                    array.push(captions, f.lb)
                else if label.get_x(f.lb) >= bar_index
                    label.set_text(f.lb, "")
    // Reuse a fixed connector pool; disabled, failed or no-longer-selected gaps leave no ghosts.
    for slot = 0 to 7
        line guide = array.get(sideGapGuides, slot)
        if slot < array.size(captions)
            label caption = array.get(captions, slot)
            float price = label.get_y(caption)
            guide := core.f_line(guide, bar_index, price, bar_index + i_right, price, color.new(C_TXT, 70), line.style_dotted, 1)
        else
            guide := core.f_hideLine(guide)
        array.set(sideGapGuides, slot, guide)
    captions

// Primary entry/draw identities cannot be repeated in supporting PD slots.
f_sidePrimaryPd(int id) =>
    id != 0 and ((f_seqLive(bullSeq) and (id == bullSeq.pdEntryId or id == bullSeq.pdDrawId)) or (f_seqLive(bearSeq) and (id == bearSeq.pdEntryId or id == bearSeq.pdDrawId)))

f_pdZones() =>
    // a live narrative's own arrays (entry OB, breaker, BPR) are not repeated as zones, whether or not
    // their lines are switched on; from its retest (its lines stop there) or its end, the zone map
    // shows them again
    array<int> picked = array.new_int()
    for side = 0 to 1
        Seq q = side == 0 ? bullSeq : bearSeq
        if not i_focus and not na(q) and q.stage >= 2 and q.stage <= 4 and na(q.tapIdx)
            if str.contains(q.arrName, "OB")
                array.push(picked, q.pdObId)
            if q.hasBrk
                array.push(picked, q.pdBbId)
            if q.pdBprId != 0
                array.push(picked, q.pdBprId)
    for slot = 0 to 11
        core.PDArr best = na
        float distance = na
        bool bestRelated = false
        if i_zones and (i_pdEngine or (i_focus and i_seqOn)) and slot < (i_focus ? i_focusExtra : i_pdLive)
            for s in pdStreams
                if s.src == 0 or (i_pdEngine and pdHasParent)
                    for a in s.A
                        bool related = f_focusRelated(a, bullSeq) or f_focusRelated(a, bearSeq)
                        bool merged = f_focusOverlap(a, bullSeq) or f_focusOverlap(a, bearSeq)
                        float dd = math.max(0.0, math.max(a.bot - close, close - a.top))
                        bool nearby = i_cleanLabels and i_sideRaw and i_focusRaw and dd <= atrS * i_sideNear
                        bool focusOK = not i_focus or (f_focusKind(a) and (related or nearby) and not merged)
                        if a.state < 4 and f_pdVisible(a) and focusOK and not array.includes(picked, a.id) and (not i_cleanLabels or not f_sidePrimaryPd(a.id))
                            bool priority = i_focus and related and not bestRelated
                            bool samePriority = not i_focus or related == bestRelated
                            if na(distance) or priority or (samePriority and (dd < distance or (dd == distance and not na(best) and a.src > best.src)))
                                best := a
                                distance := dd
                                bestRelated := related
        box zone = array.get(pdZoneBoxes, slot)
        line hi = array.get(pdZoneHi, slot)
        line lo = array.get(pdZoneLo, slot)
        line mid = array.get(pdZoneMid, slot)
        label tag = array.get(pdZoneLabels, slot)
        if not na(best)
            array.push(picked, best.id)
            color col = best.state == 1 or best.state == 2 ? C_GREY : best.dir == 1 ? C_BULL : C_BEAR
            if best.kind == "BB" or best.kind == "ROB?"
                col := C_IFVG
            if i_focus and not bestRelated
                col := C_DIM
            float midpoint = na(best.mt) ? (best.top + best.bot) / 2 : best.mt
            int shadeLeft = i_focus ? time[math.min(bar_index, 3)] : best.origin
            int shadeRight = time + math.max(chSec, 1) * 1000 * (i_focus ? 6 : i_right)
            color shade = f_arrayFill(col, best.state == 1 or best.state == 2 ? 0.4 : i_focus ? 0.5 : 1.0)
            if na(zone)
                zone := core.f_newBox(shadeLeft, best.top, shadeRight, best.bot, NOCOL, shade, ST_ZONE, true, "", C_TXT, false, false)
            else
                box.set_lefttop(zone, shadeLeft, best.top)
                box.set_rightbottom(zone, shadeRight, best.bot)
                box.set_bgcolor(zone, shade)
            if i_focus
                hi := core.f_hideLine(hi)
                lo := core.f_hideLine(lo)
                mid := core.f_line(mid, core.f_past(bar_index - 3), midpoint, bar_index + 6, midpoint, color.new(col, 60), ST_ZONE, W_ZONE)
            else
                int zoneEnd = time + math.max(chSec, 1) * 1000 * i_right
                hi := core.f_timeLine(hi, best.origin, zoneEnd, best.top, color.new(col, 30), ST_ZONE, W_ZONE)
                lo := core.f_timeLine(lo, best.origin, zoneEnd, best.bot, color.new(col, 30), ST_ZONE, W_ZONE)
                mid := core.f_timeLine(mid, best.origin, zoneEnd, midpoint, color.new(col, 45), ST_ZONEMID, W_ZONE)
            string zoneText = (i_focus and not bestRelated ? "PA · " : "") + core.f_pdName(pdCfg, best) + " · " + core.f_pdState(best.state)
            tag := core.f_label(tag, bar_index + (i_focus ? 7 : i_right + 1), midpoint, zoneText, color.new(col, i_focus ? 45 : 0), label.style_label_left, size.tiny)
            label.set_tooltip(tag, core.f_pdTip(pdCfg, best, i_tz) + "\nHTF range: " + core.f_pdRangeLoc(pdContext, best.top, best.bot) + (i_focus ? "\nSupporting midpoint; bounds above are unchanged." : ""))
        else
            hi := core.f_hideLine(hi)
            lo := core.f_hideLine(lo)
            mid := core.f_hideLine(mid)
            tag := core.f_hideLabel(tag)
            zone := core.f_hideBox(zone)
        array.set(pdZoneBoxes, slot, zone)
        array.set(pdZoneHi, slot, hi)
        array.set(pdZoneLo, slot, lo)
        array.set(pdZoneMid, slot, mid)
        array.set(pdZoneLabels, slot, tag)
    true

f_pdRangeDraw() =>
    array<float> fibs = array.from(0.25, 0.62, 0.705, 0.79, 1.272, 1.618)
    for slot = 0 to 8
        line ln = array.get(pdRangeLines, slot)
        label lb = array.get(pdRangeLabels, slot)
        bool valid = i_pdEngine and not na(pdContext.rangeHi) and (slot < 3 ? i_pdRange : not i_focus and i_pdFib)
        if valid
            float ratio = slot < 3 ? (slot == 0 ? 1.0 : slot == 1 ? 0.5 : 0.0) : array.get(fibs, slot - 3)
            float px = pdContext.rangeLo + ratio * (pdContext.rangeHi - pdContext.rangeLo)
            string labelText = pdContext.tag + (slot == 0 ? " DR H" : slot == 1 ? " DR EQ" : slot == 2 ? " DR L" : " Fib " + str.tostring(ratio))
            color col = color.new(slot < 3 ? C_GOLD : C_FIB, i_focus ? 65 : slot == 1 ? 0 : slot < 3 ? 25 : 55)
            ln := core.f_line(ln, core.f_past(pdContext.rangeKnown), px, bar_index + i_right, px, col, slot < 3 ? ST_RANGE : ST_FIB, slot < 3 ? W_RANGE : W_FIB)
            lb := core.f_label(lb, bar_index + i_right + 1, px, labelText, col, label.style_label_left, size.tiny)
            label.set_tooltip(lb, "Locked confirmed-swing range. Known at chart bar " + str.tostring(pdContext.rangeKnown) + ". " + (na(pdContext.rangeBreak) ? "Inside active range." : "Range broken; waiting for two new confirmed anchors.") + " Fib = range fractions.")
        else
            ln := core.f_hideLine(ln)
            lb := core.f_hideLabel(lb)
        array.set(pdRangeLines, slot, ln)
        array.set(pdRangeLabels, slot, lb)
    true

f_pdObstacles() =>
    for side = 0 to 1
        int d = side == 0 ? 1 : -1
        core.PDArr a = core.f_pdNear(pdCfg, d, close, true, -1)
        line ln = array.get(pdObstLines, side)
        label lb = array.get(pdObstLabels, side)
        Seq active = side == 0 ? bullSeq : bearSeq
        bool anyNarrative = f_seqLive(bullSeq) or f_seqLive(bearSeq)
        bool visibleSide = not i_focus or f_seqLive(active) or (not anyNarrative and (contDir == 0 or contDir == d))
        if i_pdEngine and i_pdObstacle and visibleSide and not na(a)
            float px = d == 1 ? math.max(close, a.bot) : math.min(close, a.top)
            bool merged = i_focus and f_seqLive(active) and active.stage >= 3 and math.abs(px - active.drawPx) < tick * 0.5
            if merged
                ln := core.f_hideLine(ln)
                lb := core.f_hideLabel(lb)
            else
                ln := core.f_line(ln, bar_index, px, bar_index + i_right, px, C_OBST, ST_OBST, W_OBST)
                lb := core.f_label(lb, bar_index + i_right + 1, px, (d == 1 ? "↑ " : "↓ ") + "obstacle " + core.f_pdName(pdCfg, a), C_OBST, label.style_label_left, size.tiny)
                label.set_tooltip(lb, "Opposing live array; no minimum R. " + core.f_pdState(a.state) + (close >= a.bot and close <= a.top ? " / price inside this zone" : "") + ". DRAW is separate.\n" + core.f_pdTip(pdCfg, a, i_tz))
        else
            ln := core.f_hideLine(ln)
            lb := core.f_hideLabel(lb)
        array.set(pdObstLines, side, ln)
        array.set(pdObstLabels, side, lb)
    true

f_pdExtraHud(table t) =>
    if i_hud and i_pdEngine
        // the structure checklist is an All arrays readout; Focus leaves its row out
        bool showScore = i_pdScore and not i_focus
        core.f_cell(t, 0, 14, "OBSTACLE", C_SHIFT)
        core.f_cell(t, 0, 15, "DRAW TYPE", C_TXT)
        if showScore
            core.f_cell(t, 0, 16, "STRUCTURE %", C_TXT)
        else
            table.clear(t, 0, 16, 2, 16)
        if i_pdSmt
            core.f_cell(t, 0, 17, "SMT", C_TXT)
        else
            table.clear(t, 0, 17, 2, 17)
        for side = 0 to 1
            int d = side == 0 ? 1 : -1
            Seq narr = side == 0 ? bullSeq : bearSeq
            core.PDArr obst = core.f_pdNear(pdCfg, d, close, true, -1)
            core.f_tipCell(t, side + 1, 14, core.f_pdName(pdCfg, obst), "No minimum-R filter; " + (na(obst) ? "none tracked" : core.f_pdState(obst.state)), C_SHIFT)
            core.f_tipCell(t, side + 1, 15, na(narr) ? "—" : narr.drawKind, "Target source: swing, array, origin or projection.", #D1D4DC)
            if showScore
                [raw, independent] = core.f_pdCounts(pdCfg, d)
                int score = i_pdScoreMode == "Raw confluence" ? math.min(100, raw * 10) : core.f_pdScore(pdCfg, d, pdContext, atrS)
                core.f_tipCell(t, side + 1, 16, str.tostring(score) + "% " + str.tostring(raw) + "/" + str.tostring(independent), "NOT probability. Checklist; raw / impulse groups. Groups are not independent.", #D1D4DC)
            if i_pdSmt
                bool smtAligned = pdSmtDir == d and not na(pdSmtAt) and bar_index - pdSmtAt <= i_pdFlowAge
                core.f_tipCell(t, side + 1, 17, smtAligned ? "✓ aligned" : "—", "Confirmed SMT on this side within the response window. CONT study gates: " + (f_pdAllowed(d) ? "pass" : "blocked") + ". Raw arrays are unaffected.", C_TXT)
    else
        table.clear(t, 0, 14, 2, 17)
    true

var table hud = table.new(core.f_pos(i_hudPos), 3, 18, bgcolor = color.new(#131722, 8), frame_color = #434651, frame_width = 1, border_color = #2A2E39, border_width = 1)
var table leg = table.new(core.f_pos(i_legPos), 2, 16, bgcolor = color.new(#131722, 8), frame_color = #434651, frame_width = 1, border_color = #2A2E39, border_width = 1)

if barstate.islast
    int edge = bar_index + i_right
    // ── swing liquidity: nearest HTF1 swings; nearby HTF1 merged and near HTF2 grouped in the
    // label; TTrades DOL and the live narratives' draws tagged
    float tolHL = atrS * i_hlClusterAtr
    float tolH2 = atrS * i_h2Near
    float dolPx = i_showDol and htfVisDir != 0 and na(htfVisFailSeq) ? (htfVisDir == 1 ? htfVisC1H : htfVisC1L) : na
    float drawHi = not na(bullSeq) and bullSeq.stage >= 3 and bullSeq.stage <= 4 ? bullSeq.drawPx : na
    float drawLo = not na(bearSeq) and bearSeq.stage >= 3 and bearSeq.stage <= 4 ? bearSeq.drawPx : na
    float hlCap  = i_hlMaxDist * math.max(f_parentAvgRange(), tick)
    // Pin the live swing DRAW before filling remaining slots with nearest liquidity.
    // Slots 0-1 highs, 2-3 lows; the second slot avoids the first slot's cluster.
    [hiFirst, hiSecond] = core.f_hlPicks(pdCfg, 1, drawHi, tolHL, close, i_hlPerSide)
    [loFirst, loSecond] = core.f_hlPicks(pdCfg, -1, drawLo, tolHL, close, i_hlPerSide)
    for slot = 0 to 3
        int hd = slot < 2 ? 1 : -1
        int idx = slot == 0 ? hiFirst : slot == 1 ? hiSecond : slot == 2 ? loFirst : loSecond
        float dpx = hd == 1 ? drawHi : drawLo
        bool isDraw = idx >= 0 and not na(dpx) and math.abs(array.get(hls, idx).price - dpx) < tick * 0.5
        // display cap: a far swing is not drawn unless it is a live draw
        if idx >= 0 and not isDraw and math.abs(array.get(hls, idx).price - close) > hlCap
            idx := -1
        if i_focus and isDraw
            idx := -1
        f_drawHLSlot(slot, idx, tolHL, tolH2, dolPx, htfVisDir, isDraw)

    // ── HTF key areas: compact ERL / IRL map, independent of narrative visibility.
    float parentRange = math.max(f_parentAvgRange(), tick)
    float maxDist = parentRange * i_pFvgNear
    float keyHlTol = parentRange * i_pFvgHL
    array<string> pins = array.new_string()
    for side = 0 to 1
        Seq seq = side == 0 ? bullSeq : bearSeq
        if f_seqLive(seq) and seq.stage >= 3 and seq.pfDrawKey != "" and not array.includes(pins, seq.pfDrawKey)
            array.push(pins, seq.pfDrawKey)
    array<core.PFGroup> groups = core.f_pfGroups(pfvgs, i_pFvgTap, pins)
    array<int> pfPicks = core.f_pfPicks(pdCfg, groups, pins, i_pFvgMax, maxDist, keyHlTol)
    for slot = 0 to 3
        core.PFGroup group = i_pFvg and pdHasParent and slot < array.size(pfPicks) ? array.get(groups, array.get(pfPicks, slot)) : na
        f_drawPFvgSlot(slot, group, pins, keyHlTol)

    // ── CISD: parent (confirmed / forming) + CISD+ ladder + live narrative CISDs in ONE renderer.
    // Anchors within tolerance form one cluster, drawn at the HIGHEST-timeframe owner's level:
    // parent confirmed 21 > parent forming 20 > CISD+ ladder 12/11/10 > live narrative 5.
    // Each cluster is centred on its final owner before the per-side line budget, so retained
    // owners sit farther apart than tol whatever their direction. A standalone narrative keeps its
    // own short line; one inside a drawn owner's cluster is hidden, and of two overlapping
    // standalone narratives the more recent shift stays (sequence ID breaks an equal-bar tie).
    while array.size(cisdNestLines) > 0
        line.delete(array.pop(cisdNestLines))
    while array.size(cisdNestLabels) > 0
        label.delete(array.pop(cisdNestLabels))
    array<core.CisdK> ks = array.new<core.CisdK>()
    float tolC = math.max(i_cisdClust * atrS, tick * 0.5)
    float nearWin = i_cisdNear * atrS
    if i_parentCisd and pdHasParent
        if parentCisdDir != 0 and not na(parentCisdLevel)
            array.push(ks, core.CisdK.new(parentCisdLevel, parentCisdDir, 21, parentCisdFrom, lblA, "", rec = bar_index))
        if not na(live) and not liveClosed
            for q2 = 0 to 1
                int fd = q2 == 0 ? 1 : -1
                float fv = fd == 1 ? pendBullLvl : pendBearLvl
                if not na(fv) and (fd == 1 ? live.c > fv : live.c < fv)
                    array.push(ks, core.CisdK.new(fv, fd, 20, fd == 1 ? pendBullFrom : pendBearFrom, lblA, "", true, rec = bar_index))
    if i_cisdMap
        for c in cMapCises
            if math.abs(close - c.lvl) <= nearWin
                [lO, lF, lI, lB] = core.f_cmFlags(cmReg, c.id)
                array.push(ks, core.CisdK.new(c.lvl, c.dir, 10 + c.si, c.fromB, f_cmTag(c.si), core.f_cmTagTxt(lO, lF, lI, lB), c.tested, rec = c.atB))
    for q = 0 to 1
        Seq s = q == 0 ? bullSeq : bearSeq
        if not na(s)
            if not na(s.lnCisd) and s.stage >= 2 and s.stage <= 4
                array.push(ks, core.CisdK.new(s.cisdLvl, s.dir, 5, s.cisdIdx, core.f_tfLbl(timeframe.period), "", false, s.id, rec = s.shiftIdx))
    array<int> picks = core.f_cisdPicks(ks, tolC, close, i_cisdSlots)
    for top in picks
        core.CisdK tk = array.get(ks, top)
        int lft = tk.fromB
        int cnt = 0
        for k in ks
            if k.cl == tk.cl and k.dir == tk.dir
                cnt += 1
                lft := math.min(lft, k.fromB)
        // Always render the selected owner at its own price and polarity, even
        // for a chart-only cluster that also contains a live narrative.
        string names = ""
        string allTags = "·"
        string opp = ""
        int named = 0
        for rank = 0 to 16
            int p = 21 - rank
            for k in ks
                if k.cl == tk.cl and k.pri == p
                    if k.dir == tk.dir
                        if not str.contains("+" + names + "+", "+" + k.name + "+")
                            names += (names == "" ? "" : "+") + k.name
                            named += 1
                        if k.tags != ""
                            allTags += k.tags + "·"
                    else
                        opp += (opp == "" ? "" : "\n") + k.name + " CISD" + (k.dir == 1 ? "+ " : "- ") + str.tostring(k.lvl, format.mintick)
        string tg = core.f_cmTagTxt(str.contains(allTags, "·OB·"), str.contains(allTags, "·FVG·"), str.contains(allTags, "·IFVG·"), str.contains(allTags, "·BPR·"))
        string txt = names + " CISD" + (tk.dir == 1 ? "+" : "-") + (tg == "" ? "" : " · " + tg) + (tk.pri == 20 ? " · forming" : tk.dashed ? " · tested" : "") + (cnt > named ? " x" + str.tostring(cnt) : "")
        string tip = names + " CISD" + (tk.dir == 1 ? "+ " : "- ") + str.tostring(tk.lvl, format.mintick) + (opp == "" ? "" : "\nHTF priority over:\n" + opp)
        // owner rows: parent (confirmed / forming), CISD+ map, live narrative. Forming / tested = dashed.
        color cc = tk.pri >= 20 ? C_PCISD : tk.pri >= 10 ? C_MCISD : C_NCISD
        string cs = tk.dashed ? line.style_dashed : tk.pri >= 20 ? ST_PCISD : tk.pri >= 10 ? ST_MCISD : ST_NCISD
        array.push(cisdNestLines, core.f_newLine(core.f_past(lft), tk.lvl, edge, tk.lvl, color.new(cc, tk.dashed ? 45 : 0), cs, tk.pri >= 20 ? W_PCISD : tk.pri >= 10 ? W_MCISD : W_NCISD, false))
        array.push(cisdNestLabels, core.f_newLabel(edge + 1, tk.lvl, txt, label.style_label_left, NOCOL, color.new(cc, tk.dashed ? 35 : 0), size.tiny, tip, true))
    array<int> hidden = core.f_cisdHiddenNarratives(ks, picks, tolC)
    // Restore any standalone narrative; only a visible winning line may absorb it.
    for q = 0 to 1
        Seq s = q == 0 ? bullSeq : bearSeq
        if not na(s)
            if not na(s.lnCisd) and s.stage >= 2 and s.stage <= 4
                bool hid = array.includes(hidden, s.id)
                line.set_color(s.lnCisd, hid ? NOCOL : C_NCISD)
                label.set_textcolor(s.lbCisd, hid ? NOCOL : C_NCISD)

    // ── on-chart C1–C4 tags retain the paired HTF sequence
    f_drawChartCTags()

    // ── chart arrays (raw PA): the nearest live arrays per side reach the live bar with a tag; every
    // other gap stays a short history mark. HTF continuation arms the nearest one on its side while
    // it still sits beyond the previous HTF1 body 50%.
    array<int> actIx = array.new_int()
    int    contIx  = -1
    string contArr = ""
    int    nFv     = array.size(fvgs)
    for side = 0 to 1
        int pol = side == 0 ? 1 : -1
        for rep = 1 to i_rawLive
            int   bestA = -1
            float bestD = na
            if nFv > 0
                for i = 0 to nFv - 1
                    FVG fa = array.get(fvgs, i)
                    int fp = fa.state >= 2 ? -fa.dir : fa.dir
                    if fa.sty == 1 and fa.state < 3 and fp == pol and not array.includes(actIx, i) and (pol == 1 ? fa.bot <= close : fa.top >= close)
                        float dd = pol == 1 ? math.max(0.0, close - fa.top) : math.max(0.0, fa.bot - close)
                        if bestA < 0 or dd < bestD
                            bestA := i
                            bestD := dd
            if bestA >= 0
                array.push(actIx, bestA)
                FVG fb = array.get(fvgs, bestA)
                bool arrayAfterResponse = not i_pdEngine or i_pdCont == "Legacy body 50%" or (not na(pdContext.contBar) and fb.born >= pdContext.contBar)
                if rep == 1 and arrayAfterResponse and contDir == pol and ((i_pdEngine and i_pdCont != "Legacy body 50%") or (not na(contMid) and (pol == 1 ? fb.top >= contMid : fb.bot <= contMid)))
                    contIx  := bestA
                    contArr := (pol == 1 ? "+" : "-") + (fb.state >= 2 ? "iFVG" : "FVG")
    array<int> focusGaps = array.new_int()
    if i_focus and i_focusExtra > 0 and nFv > 0
        for side = 0 to 1
            Seq s = side == 0 ? bullSeq : bearSeq
            int chosen = -1
            float distance = na
            if f_seqLive(s)
                for i = 0 to nFv - 1
                    FVG f = array.get(fvgs, i)
                    bool owned = not na(f.owner) and f.owner.id == s.id
                    bool footprint = s.stage == 4 ? (f.bg or f.mg) : f.role == 3
                    int polarity = f.state >= 2 ? -f.dir : f.dir
                    if owned and footprint and f.sty == 1 and f.state < 3 and not f.isEntry and polarity == s.dir and (na(s.arrIdx) or f.idx != s.arrIdx)
                        float dd = math.max(0.0, math.max(f.bot - close, close - f.top))
                        if na(distance) or dd < distance
                            chosen := i
                            distance := dd
            if chosen >= 0
                array.push(focusGaps, chosen)
    if nFv > 0
        for i = 0 to nFv - 1
            FVG fl = array.get(fvgs, i)
            bool gapAct = fl.sty == 1 and (array.includes(actIx, i) or f_fvgLiveIfvg(fl))
            f_fvgLines(fl, gapAct)
            if fl.sty == 2 and (fl.state == 0 or fl.state == 2)
                f_fvgEdge(fl, bar_index)
            // every drawn gap is painted from its final state here (or when it leaves the registry)
            if fl.sty > 0
                f_fvgPaint(fl, gapAct)
            if i_focus and array.includes(focusGaps, i)
                f_focusGap(fl, false)
    if contIx >= 0
        FVG fc = array.get(fvgs, contIx)
        Seq narr = contDir == 1 ? bullSeq : bearSeq
        bool selectedReaction = f_seqLive(narr) and narr.stage >= 3
        sideContIx := not i_focus or not selectedReaction ? contIx : -1
        if i_focus
            if not selectedReaction
                f_focusGap(fc, true)
        else if not na(fc.lb)
            label.set_text(fc.lb, f_fvgText(fc) + " · CONT")

    // ── HTF continuation: the previous HTF1 body 50% under / over the live HTF1 candle
    if i_cont and i_contLine and not na(contMid) and not na(contFrom)
        color ccol = contDir == 1 ? C_BULL : contDir == -1 ? C_BEAR : C_CONT
        contLn := core.f_line(contLn, core.f_past(contFrom), contMid, edge, contMid, ccol, ST_CONT, W_CONT)
        contLb := core.f_label(contLb, edge + 1, contMid, contextTfLbl + " 50%" + (i_pdEngine and i_pdCont != "Legacy body 50%" ? "" : contDir == 1 ? " · CONT ▲" : contDir == -1 ? " · CONT ▼" : ""), ccol, label.style_label_left, size.tiny)
    else
        contLn := core.f_hideLine(contLn)
        contLb := core.f_hideLabel(contLb)
    if acc.on and not na(acc.bx)
        box.set_right(acc.bx, bar_index)
    if not na(bullSeq)
        bullSeq.liveEdges()
    if not na(bearSeq)
        bearSeq.liveEdges()

    // ── MMXM: the live second side of the curve (optional arc; the engine runs regardless)
    for q = 0 to 1
        Seq mmS = q == 0 ? bullSeq : bearSeq
        polyline mmP = array.get(mmPl, q)
        if not na(mmP)
            polyline.delete(mmP)
        mmP := na
        if i_mmxmArcs and not na(mmS) and mmS.mmxm and mmS.stage >= 2 and mmS.stage <= 4 and not na(mmS.dlvIdx) and mmS.dlvIdx - mmS.extIdx >= 4 and mmS.dir * (mmS.dlvExt - mmS.ext) > 0
            mmP := polyline.new(core.f_curvePts(mmS.dlvIdx, mmS.dlvExt, mmS.extIdx, mmS.ext, false), curved = true, line_color = color.new(C_ARC, 40), line_style = ST_ARC, line_width = W_ARC, force_overlay = true)
        array.set(mmPl, q, mmP)

    if i_hud
        Seq sb = not na(bullSeq) ? bullSeq : lastBull
        Seq sr = not na(bearSeq) ? bearSeq : lastBear
        [hB, aB, gB, shB, arB, mmB, drB] = f_side(sb)
        [hR, aR, gR, shR, arR, mmR, drR] = f_side(sr)
        [tB, meB] = f_tallyTxt(0)
        [tR, meR] = f_tallyTxt(1)
        color tx  = #D1D4DC
        color dim = #9598A1
        string seqTxt = htfVisDir == 0 ? "—" : (htfVisDir == 1 ? "▲" : "▼") + htfVisMode + " " + (htfVisAlive ? "C" + str.tostring(math.min(4, live.seq - htfVisC2Seq + 2)) : na(htfVisFailSeq) ? "done" : "xC2")
        table.cell(hud, 0, 0, "ICY×22", text_color = tx, bgcolor = #1E222D, text_size = size.tiny, text_halign = text.align_left, text_font_family = font.family_monospace)
        table.cell(hud, 1, 0, "▲", text_color = C_WIN, bgcolor = #1E222D, text_size = size.tiny)
        table.cell(hud, 2, 0, "▼", text_color = C_LOSS, bgcolor = #1E222D, text_size = size.tiny)
        core.f_cell(hud, 0, 1, "TF", dim)
        core.f_cell(hud, 1, 1, core.f_tfLbl(timeframe.period) + "→" + contextTfLbl, tx)
        core.f_cell(hud, 2, 1, pdFallback ? "1D/1W native" : pairOK ? lblB : "unpaired", tx)
        core.f_cell(hud, 0, 2, pairOK ? "SEQ" : "1D", dim)
        core.f_cell(hud, 1, 2, pairOK ? seqTxt : na(dT0) ? "—" : dailyForming ? "forming" : "closed", htfVisDir == 1 ? C_BULL : htfVisDir == -1 ? C_BEAR : dim)
        bool pfBull = not na(live) and not liveClosed and not na(pendBullLvl) and live.c > pendBullLvl
        bool pfBear = not na(live) and not liveClosed and not na(pendBearLvl) and live.c < pendBearLvl
        string pcTxt = pfBull ? "CISD+ …" : pfBear ? "CISD- …" : parentCisdDir == 1 ? "CISD+ ✓" : parentCisdDir == -1 ? "CISD- ✓" : "—"
        core.f_cell(hud, 2, 2, pdHasParent ? pcTxt : "—", pfBull or pfBear ? dim : parentCisdDir == 1 ? C_BULL : parentCisdDir == -1 ? C_BEAR : dim)
        core.f_cell(hud, 0, 3, "CONT", dim)
        core.f_cell(hud, 1, 3, contDir == 1 ? "▲ " + (contArr == "" ? "armed" : contArr) : "—", contDir == 1 ? C_BULL : dim)
        core.f_cell(hud, 2, 3, contDir == -1 ? "▼ " + (contArr == "" ? "armed" : contArr) : "—", contDir == -1 ? C_BEAR : dim)
        array<string> narrNames = array.from("①HTF", "②LIQ", "③GRAB", "④SHIFT", "⑤ARRAY", "⑥MMXM", "⑦DRAW")
        array<string> narrBull = array.from(hB, aB, gB, shB, arB, mmB, drB)
        array<string> narrBear = array.from(hR, aR, gR, shR, arR, mmR, drR)
        for row = 0 to 6
            core.f_cell(hud, 0, row + 4, array.get(narrNames, row), dim)
            core.f_cell(hud, 1, row + 4, array.get(narrBull, row), tx)
            core.f_cell(hud, 2, row + 4, array.get(narrBear, row), tx)
        core.f_cell(hud, 0, 11, "STATE", dim)
        core.f_cell(hud, 1, 11, f_stateTxt(sb), f_stateCol(sb))
        core.f_cell(hud, 2, 11, f_stateTxt(sr), f_stateCol(sr))
        core.f_cell(hud, 0, 12, "N·✓·✕ " + (histDays == 0 ? "All" : str.tostring(histDays) + "D"), dim)
        core.f_cell(hud, 1, 12, tB, tx)
        core.f_cell(hud, 2, 12, tR, tx)
        core.f_cell(hud, 0, 13, "M·E·A", dim)
        core.f_cell(hud, 1, 13, meB, tx)
        core.f_cell(hud, 2, 13, meR, tx)

    if i_legend
        table.cell(leg, 0, 0, "", bgcolor = #1E222D, text_size = size.tiny)
        table.cell(leg, 1, 0, "LEGEND", text_color = #D1D4DC, bgcolor = #1E222D, text_size = size.tiny, text_halign = text.align_left)
        array<color> legInk = array.from(C_LIQ, C_HTF, C_FVGB, C_FVGS, C_IFVG, C_ARRB, C_ARR, C_BG, C_EXH, C_OB, C_DRAW, C_CONT, C_GOLD, C_ACC, C_DIM)
        array<string> legTxt = array.from("HTF1 swing BSL / SSL", "HTF FVG key area", "Bull FVG (BISI)", "Bear FVG (SIBI)", "iFVG", "Bull MSS P / D reaction", "Bear MSS P / D reaction", "Breakaway · Measuring Gap", "Exhaustion Gap", "CISD · OB · Breaker lines", "DRAW", "Previous HTF body 50%", "Dealing range · Fib", "Liquidity Generation", "Focus study colour (dim)")
        for row = 0 to array.size(legTxt) - 1
            core.f_swatch(leg, row + 1, array.get(legInk, row), array.get(legTxt, row))

if barstate.islast
    f_pdZones()
    f_pdRangeDraw()
    f_pdObstacles()
    f_pdExtraHud(hud)
    f_focusPrimary()

    // Collect only current side captions; historical candle annotations stay anchored.
    array<core.SideTag> sideTags = array.new<core.SideTag>()
    core.f_sideCollect(sideTags, hlLb)
    core.f_sideCollect(sideTags, pfLb)
    core.f_sideCollect(sideTags, cisdNestLabels)
    // Focus slot = side * 5 + role: roles 1-4 only. The grab caption (role 0) stays on its short mark.
    core.f_sideCollect(sideTags, array.slice(focusLabels, 1, 5))
    core.f_sideCollect(sideTags, array.slice(focusLabels, 6, 10))
    core.f_sideCollect(sideTags, pdZoneLabels)
    core.f_sideCollect(sideTags, pdRangeLabels)
    core.f_sideCollect(sideTags, pdObstLabels)
    core.f_sideCollect(sideTags, array.from(contLb))
    array<label> currentGaps = f_sideGapLabels(sideContIx)
    core.f_sideCollect(sideTags, currentGaps)
    float labelStep = math.max(tick * 4, math.max(atrS * 0.35, nz(sideViewHi - sideViewLo, atrS) / 36.0))
    float labelScale = i_sideSpacing * (i_lblSz == "Normal" ? 1.3 : i_lblSz == "Tiny" ? 0.8 : 1.0)
    core.f_sideLayout(sideTags, sideLeaders, i_cleanLabels, bar_index + i_right + i_lblGap, labelStep, labelScale, C_TXT, SZ)

// =============================================================================
// 11 · EXPORTS & ALERTS
// =============================================================================
float xBullStage = na(bullSeq) ? 0 : bullSeq.stage
float xBullRt    = na(bullSeq) ? na : bullSeq.rtPx
float xBullInv   = na(bullSeq) ? na : bullSeq.invPx
float xBullDraw  = na(bullSeq) ? na : bullSeq.drawPx
float xBearStage = na(bearSeq) ? 0 : bearSeq.stage
float xBearRt    = na(bearSeq) ? na : bearSeq.rtPx
float xBearInv   = na(bearSeq) ? na : bearSeq.invPx
float xBearDraw  = na(bearSeq) ? na : bearSeq.drawPx
plot(xBullStage, "X_bullStage", display = display.data_window)
plot(xBullRt, "X_bullRetest", display = display.data_window)
plot(xBullInv, "X_bullInvalidation", display = display.data_window)
plot(xBullDraw, "X_bullDraw", display = display.data_window)
plot(xBearStage, "X_bearStage", display = display.data_window)
plot(xBearRt, "X_bearRetest", display = display.data_window)
plot(xBearInv, "X_bearInvalidation", display = display.data_window)
plot(xBearDraw, "X_bearDraw", display = display.data_window)
plot(htfVisDir * (htfVisAlive ? 1 : 0), "X_htfSequenceDir", display = display.data_window)
plot(contDir, "X_htfContinuation", display = display.data_window)
plot(array.get(ev, EV_SHIFT) ? 1 : array.get(ev, EV_SHIFT + 1) ? -1 : 0, "X_shiftPulse", display = display.data_window)

alertcondition(array.get(ev, EV_GRAB), "Bull liquidity grab", "ICY×22: HTF1 sell-side swing taken - bullish narrative mapping")
alertcondition(array.get(ev, EV_GRAB + 1), "Bear liquidity grab", "ICY×22: HTF1 buy-side swing taken - bearish narrative mapping")
alertcondition(array.get(ev, EV_SHIFT), "Bull market shift", "ICY×22: bullish market shift after a sell-side grab")
alertcondition(array.get(ev, EV_SHIFT + 1), "Bear market shift", "ICY×22: bearish market shift after a buy-side grab")
alertcondition(array.get(ev, EV_ARRAY), "Bull entry array", "ICY×22: bullish entry array mapped after the shift")
alertcondition(array.get(ev, EV_ARRAY + 1), "Bear entry array", "ICY×22: bearish entry array mapped after the shift")
alertcondition(array.get(ev, EV_TAP) or array.get(ev, EV_TAP + 1), "Array retested", "ICY×22: entry array retested - delivery toward the draw")
alertcondition(array.get(ev, EV_DRAW) or array.get(ev, EV_DRAW + 1), "Draw reached", "ICY×22: draw on liquidity reached")
alertcondition(array.get(ev, EV_FAIL) or array.get(ev, EV_FAIL + 1), "Narrative failed", "ICY×22: the grab extreme traded after the retest")
alertcondition(array.get(ev, EV_CONT), "Bull continuation armed", "ICY×22: bullish continuation qualified by the selected CONT mode")
alertcondition(array.get(ev, EV_CONT + 1), "Bear continuation armed", "ICY×22: bearish continuation qualified by the selected CONT mode")

// Expanded diagnostics: checklist scores are not confidence probabilities.
plot(i_pdEngine ? pdContext.flow : na, "X_PD_flow (2 range / 3 mixed)", display = display.data_window)
plot(i_pdEngine ? pdContSignal : na, "X_PD_causal_CONT", display = display.data_window)
plot(i_pdEngine ? pdContext.rangeHi : na, "X_PD_range_high", display = display.data_window)
plot(i_pdEngine ? pdContext.rangeLo : na, "X_PD_range_low", display = display.data_window)
plot(i_pdEngine and i_pdScore ? core.f_pdScore(pdCfg, 1, pdContext, atrS) : na, "X_PD_bull_structure_score_NOT_probability", display = display.data_window)
plot(i_pdEngine and i_pdScore ? core.f_pdScore(pdCfg, -1, pdContext, atrS) : na, "X_PD_bear_structure_score_NOT_probability", display = display.data_window)
alertcondition(cf and i_pdEngine and (pdS0.holdPulse != 0 or pdS1.holdPulse != 0 or pdS2.holdPulse != 0), "PD array held", "ICY×22: source-timeframe array hold confirmed")
alertcondition(cf and i_pdEngine and (pdS0.failPulse != 0 or pdS1.failPulse != 0 or pdS2.failPulse != 0), "PD array failed", "ICY×22: source-timeframe close accepted through an array")
alertcondition(cf and i_pdEngine and pdContext.exhPulse != 0, "Early exhaustion study event", "ICY×22: provisional exhaustion or subsequent response; inspect EXH state")
