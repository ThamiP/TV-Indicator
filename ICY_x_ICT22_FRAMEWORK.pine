string ST_CONT      = core.f_sty(input.string("Dotted", "", options = ["Solid", "Dotted", "Dashed"], group = GRP_DLVL, inline = "l6", display = display.none, active = i_contLine))
int    W_CONT       = input.int(1, "", minval = 1, maxval = 4, group = GRP_DLVL, inline = "l6", display = display.none, active = i_contLine)
bool   i_pdRange    = input.bool(true, "Dealing range + EQ", group = GRP_DLVL, inline = "l7", tooltip = "Locked HTF dealing range from the PD response engine.")
